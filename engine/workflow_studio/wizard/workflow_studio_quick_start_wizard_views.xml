<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_workflow_studio_quick_start_wizard_form" model="ir.ui.view">
        <field name="name">workflow.studio.quick.start.wizard.form</field>
        <field name="model">workflow.studio.quick.start.wizard</field>
        <field name="arch" type="xml">
            <form string="Workflow Studio Quick Start" create="0" edit="0">
                <group>
                    <field name="model_source" widget="radio"/>
                    <field
                        name="model_name"
                        placeholder="My Request Model"
                        invisible="model_source != 'create_new'"
                        required="model_source == 'create_new'"
                    />
                    <field
                        name="existing_model_id"
                        placeholder="Select an approval-enabled model"
                        invisible="model_source != 'use_existing'"
                        required="model_source == 'use_existing'"
                        options="{'no_create': True, 'no_open': True}"
                    />
                    <field name="category_name" placeholder="My Workflow Category"/>
                    <field name="has_approval" readonly="1"/>
                </group>
                <footer>
                    <button
                        name="action_create_and_open_studio"
                        type="object"
                        string="Create And Open Studio"
                        class="btn-primary"
                    />
                    <button string="Cancel" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_workflow_studio_quick_start_wizard" model="ir.actions.act_window">
        <field name="name">Workflow Studio Quick Start</field>
        <field name="res_model">workflow.studio.quick.start.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="view_id" ref="view_workflow_studio_quick_start_wizard_form"/>
    </record>

</odoo>
