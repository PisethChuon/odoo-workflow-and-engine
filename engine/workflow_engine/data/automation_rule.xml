<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="automation_set_submit_date" model="base.automation">
            <field name="name">WF: set submit date</field>
            <field name="model_id" ref="workflow_engine.model_workflow_base_approval_request"/>
            <field name="action_server_ids" eval="[(6, 0, [ref('workflow_engine.action_server_set_submit_date')])]"/>
            <field name="trigger">on_create_or_write</field>
            <field name="trigger_field_ids" eval="[(6, 0, [
                ref('workflow_engine.field_workflow_base_approval_request__state')
            ])]"/>
            <field name="filter_pre_domain">[("state", "=", "new")]</field>
            <field name="filter_domain">[("state", "=", "waiting")]</field>
            <field name="active">1</field>
        </record>
    </data>
</odoo>