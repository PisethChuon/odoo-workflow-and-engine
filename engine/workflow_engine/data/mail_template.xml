<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="email_template_workflow_approval" model="mail.template">
            <field name="name">WF: Approval</field>
            <field name="model_id" ref="model_workflow_base_approval_request"/>
            <field name="subject">{{ object.current_activity_name }} Notification (Ref: {{ object.name }})</field>
            <field name="email_from">{{ object.company_id.email }}</field>
            <field name="auto_delete" eval="True"/>
            <field name="body_html" type="html">
                <table width="590" style="background-color: white; border-collapse:separate; padding: 0 8px;">
                    <tr>
                        <td valign="top">
                            <div style="font-size: 14px;">
                                Dear
                                <strong>
                                    <t t-out="ctx.get('user_name') or 'Approver'"/>
                                </strong>
                                ,
                                <br/>
                                <br/>

                                You have been assigned to approve the following request:
                                <br/>
                                <strong>Request:</strong>
                                <t t-out="object.name or 'Untitled'"/>
                                <br/>
                                <strong>Requester:</strong>
                                <t t-out="object.request_owner_id.name or 'N/A'"/>
                                <br/>
                                <strong>Category:</strong>
                                <t t-out="object.category_id.name or 'N/A'"/>
                                <br/>
                                <strong>Due Date:</strong>
                                <t t-if="object.date_end">
                                    <t t-out="format_datetime(object.date_end)"/>
                                </t>
                                <t t-else="">N/A</t>
                                <br/>
                                <br/>

                                Please review and take action at your earliest convenience.
                                <br/>
                                <br/>

                                <a t-att-href="object.get_access_action_url() if object.get_access_action_url() else '#'"
                                   style="background-color: #875A7B; color: white; padding: 10px 15px; text-decoration: none; border-radius: 5px;">
                                    View Request
                                </a>
                                <br/>
                                <br/>

                                Best regards,
                                <br/>
                                <strong>
                                    <t t-out="object.company_id.name if object.company_id else 'Workflow System'"/>
                                </strong>
                                <br/>
                                <span style="font-size: 11px; color: grey;">This is an automated message.</span>
                            </div>
                        </td>
                    </tr>
                </table>
            </field>
        </record>
        <record id="email_template_workflow_rework" model="mail.template">
            <field name="name">WF: Rework</field>
            <field name="model_id" ref="model_workflow_base_approval_request"/>
            <field name="subject">Email Notification (Ref: {{ object.name }})</field>
            <field name="email_from">{{ object.company_id.email }}</field>
            <field name="auto_delete" eval="True"/>
            <field name="body_html" type="html">
                <table width="590" style="background-color: white; border-collapse:separate; padding: 0 8px;">
                    <tr>
                        <td valign="top">
                            <div style="font-size: 14px;">
                                Dear
                                <strong>
                                    <t t-out="object.request_owner_id.name or 'Requester'"/>
                                </strong>
                                ,
                                <br/>
                                <br/>

                                Your request has been sent back for <strong>rework</strong> in the workflow process.
                                <br/>
                                <strong>Request:</strong>
                                <t t-out="object.name or 'Untitled'"/>
                                <br/>
                                <strong>Category:</strong>
                                <t t-out="object.category_id.name or 'N/A'"/>
                                <br/>
                                <strong>Current Stage:</strong>
                                <t t-out="object.current_activity_name or 'Unknown'"/>
                                <br/>
                                <strong>Last Approved By:</strong>
                                <t t-if="object.approver_ids">
                                    <t t-out="object.approver_ids.filtered(lambda a: a.status == 'approved')[-1].user_id.name if object.approver_ids.filtered(lambda a: a.status == 'approved') else 'N/A'"/>
                                </t>
                                <br/>
                                <br/>

                                Please update and resubmit the request accordingly.
                                <br/>
                                <br/>

                                <a t-att-href="object.get_access_action_url() if object.get_access_action_url() else '#'"
                                   style="background-color: #875A7B; color: white; padding: 10px 15px; text-decoration: none; border-radius: 5px;">
                                    Update Request
                                </a>
                                <br/>
                                <br/>

                                Best regards,
                                <br/>
                                <strong>
                                    <t t-out="object.company_id.name if object.company_id else 'Workflow System'"/>
                                </strong>
                                <br/>
                                <span style="font-size: 11px; color: grey;">This is an automated message.</span>
                            </div>
                        </td>
                    </tr>
                </table>
            </field>
        </record>
        <record id="email_template_workflow_reject" model="mail.template">
            <field name="name">WF: Reject</field>
            <field name="model_id" ref="model_workflow_base_approval_request"/>
            <field name="subject">Email Notification (Ref: {{ object.name }})</field>
            <field name="email_from">{{ object.company_id.email }}</field>
            <field name="auto_delete" eval="True"/>
            <field name="body_html" type="html">
                <table width="590" style="background-color: white; border-collapse:separate; padding: 0 8px;">
                    <tr>
                        <td valign="top">
                            <div style="font-size: 14px;">
                                Dear
                                <strong>
                                    <t t-out="object.request_owner_id.name or 'Employee'"/>
                                </strong>
                                ,
                                <br/>
                                <br/>

                                We regret to inform you that your request titled
                                <strong>
                                    <t t-out="object.name or 'Untitled'"/>
                                </strong>
                                was <strong style="color: red;">rejected</strong>.
                                <br/>
                                <br/>

                                <strong>Category:</strong>
                                <t t-out="object.category_id.name or 'N/A'"/>
                                <br/>
                                <strong>Rejected By:</strong>
                                <t t-if="object.approver_ids">
                                    <t t-out="object.approver_ids.filtered(lambda a: a.status == 'refused')[-1].user_id.name if object.approver_ids.filtered(lambda a: a.status == 'refused') else 'N/A'"/>
                                </t>
                                <br/>
                                <strong>Decision:</strong>
                                <t t-out="object.approver_ids.filtered(lambda a: a.status == 'refused')[-1].user_decision if object.approver_ids.filtered(lambda a: a.status == 'refused') else 'No reason provided'"/>
                                <br/>
                                <br/>

                                If you believe this is a mistake, please reach out to your approver or resubmit the
                                request if applicable.
                                <br/>
                                <br/>

                                <a t-att-href="object.get_access_action_url() if object.get_access_action_url() else '#'"
                                   style="background-color: #C62828; color: white; padding: 10px 15px; text-decoration: none; border-radius: 5px;">
                                    View Request
                                </a>
                                <br/>
                                <br/>

                                Best regards,
                                <br/>
                                <strong>
                                    <t t-out="object.company_id.name if object.company_id else 'Workflow System'"/>
                                </strong>
                                <br/>
                                <span style="font-size: 11px; color: grey;">This is an automated message.</span>
                            </div>
                        </td>
                    </tr>
                </table>
            </field>
        </record>
        <record id="email_template_workflow_cancel" model="mail.template">
            <field name="name">WF: Cancel</field>
            <field name="model_id" ref="model_workflow_base_approval_request"/>
            <field name="subject">Email Notification (Ref: {{ object.name }})</field>
            <field name="email_from">{{ object.company_id.email }}</field>
            <field name="auto_delete" eval="True"/>
            <field name="body_html" type="html">
                <table width="590" style="background-color: white; border-collapse:separate; padding: 0 8px;">
                    <tr>
                        <td valign="top">
                            <div style="font-size: 14px;">
                                Dear
                                <strong>
                                    <t t-out="object.request_owner_id.name or 'Employee'"/>
                                </strong>
                                ,
                                <br/>
                                <br/>

                                We would like to inform you that your request titled
                                <strong>
                                    <t t-out="object.name or 'Untitled'"/>
                                </strong>
                                has been <strong style="color: red;">cancelled</strong>.
                                <br/>
                                <br/>

                                <strong>Category:</strong>
                                <t t-out="object.category_id.name or 'N/A'"/>
                                <br/>
                                <strong>Cancelled By:</strong>
                                <t t-out="object.write_uid.name if object.write_uid else 'System'"/>
                                <br/>
                                <strong>Cancellation Date:</strong>
                                <t t-out="format_datetime(object.write_date) if object.write_date else 'N/A'"/>
                                <br/>
                                <br/>

                                If this was a mistake or you wish to resubmit, please initiate a new request or contact
                                your supervisor.
                                <br/>
                                <br/>

                                <a t-att-href="object.get_access_action_url() if object.get_access_action_url() else '#'"
                                   style="background-color: #B71C1C; color: white; padding: 10px 15px; text-decoration: none; border-radius: 5px;">
                                    View Request
                                </a>
                                <br/>
                                <br/>

                                Best regards,
                                <br/>
                                <strong>
                                    <t t-out="object.company_id.name if object.company_id else 'Workflow System'"/>
                                </strong>
                                <br/>
                                <span style="font-size: 11px; color: grey;">This is an automated message.</span>
                            </div>
                        </td>
                    </tr>
                </table>
            </field>
        </record>
        <record id="email_template_workflow_auto_cancel" model="mail.template">
            <field name="name">WF: Auto-cancel</field>
            <field name="model_id" ref="model_workflow_base_approval_request"/>
            <field name="subject">Email Notification (Ref: {{ object.name }})</field>
            <field name="email_from">{{ object.company_id.email }}</field>
            <field name="auto_delete" eval="True"/>
            <field name="body_html" type="html">
                <table width="590" style="background-color: white; border-collapse: separate; padding: 0 8px;">
                    <tr>
                        <td valign="top">
                            <div style="font-size: 14px;">
                                Hello
                                <strong>
                                    <t t-out="object.request_owner_id.name or 'User'"/>
                                </strong>
                                ,
                                <br/>
                                <br/>

                                Your request
                                <strong>
                                    <t t-out="object.name or 'Untitled Request'"/>
                                </strong>
                                was automatically canceled because it was pending too long
                                <br/>
                                <br/>

                                <strong>Submitted On:</strong>
                                <t t-out="format_datetime(object.create_date)"/>
                                <br/>
                                <strong>Status:</strong>
                                Canceled
                                <br/>
                                <br/>

                                If you believe this was a mistake or still require assistance, please submit a new
                                request.
                                <br/>
                                <br/>

                                Best regards,
                                <br/>
                                <strong>
                                    <t t-out="object.company_id.name if object.company_id else 'Workflow System'"/>
                                </strong>
                                <br/>
                                <span style="font-size: 11px; color: grey;">This is an automated message.</span>
                            </div>
                        </td>
                    </tr>
                </table>
            </field>
        </record>
        <record id="email_template_workflow_approve" model="mail.template">
            <field name="name">WF: Approve</field>
            <field name="model_id" ref="model_workflow_base_approval_request"/>
            <field name="subject">Email Notification (Ref: {{ object.name }})</field>
            <field name="email_from">{{ object.company_id.email }}</field>
            <field name="auto_delete" eval="True"/>
            <field name="body_html" type="html">
                <table width="590" style="background-color: white; border-collapse:separate; padding: 0 8px;">
                    <tr>
                        <td valign="top">
                            <div style="font-size: 14px;">
                                Dear
                                <strong>
                                    <t t-out="object.request_owner_id.name or 'Employee'"/>
                                </strong>
                                ,
                                <br/>
                                <br/>

                                Congratulations! Your request titled
                                <strong>
                                    <t t-out="object.name or 'Untitled'"/>
                                </strong>
                                has been fully <strong style="color: green;">approved</strong> and completed.
                                <br/>
                                <br/>

                                <strong>Category:</strong>
                                <t t-out="object.category_id.name or 'N/A'"/>
                                <br/>
                                <strong>Final Approver:</strong>
                                <t t-if="object.approver_ids">
                                    <t t-out="object.approver_ids.filtered(lambda a: a.status == 'approved')[-1].user_id.name if object.approver_ids.filtered(lambda a: a.status == 'approved') else 'N/A'"/>
                                </t>
                                <br/>
                                <strong>Final Decision:</strong>
                                <t t-out="object.approver_ids.filtered(lambda a: a.status == 'approved')[-1].user_decision if object.approver_ids.filtered(lambda a: a.status == 'approved') else 'Approved'"/>
                                <br/>
                                <br/>

                                You may now proceed with the next steps based on this approval.
                                <br/>
                                <br/>

                                <a t-att-href="object.get_access_action_url() if object.get_access_action_url() else '#'"
                                   style="background-color: #2E7D32; color: white; padding: 10px 15px; text-decoration: none; border-radius: 5px;">
                                    View Completed Request
                                </a>
                                <br/>
                                <br/>

                                Best regards,
                                <br/>
                                <strong>
                                    <t t-out="object.company_id.name if object.company_id else 'Workflow System'"/>
                                </strong>
                                <br/>
                                <span style="font-size: 11px; color: grey;">This is an automated message.</span>
                            </div>
                        </td>
                    </tr>
                </table>
            </field>
        </record>
        <record id="email_template_workflow_email_notify" model="mail.template">
            <field name="name">WF: email notify</field>
            <field name="model_id" ref="model_workflow_base_approval_request"/>
            <field name="subject">{{ object.workflow_email_owner_update_subject() }}</field>
            <field name="email_from">{{ object.company_id.email }}</field>
            <field name="auto_delete" eval="True"/>
            <field name="body_html" type="html">
                <table width="590" style="background-color: white; border-collapse:separate; padding: 0 8px;">
                    <tr>
                        <td valign="top">
                            <div style="font-size: 14px;">
                                <t t-if="ctx.get('workflow_owner_update_greeting_name')">
                                    Dear
                                    <strong>
                                        <t t-out="ctx.get('workflow_owner_update_greeting_name')"/>
                                    </strong>
                                    ,
                                </t>
                                <t t-else="">
                                    Dear User,
                                </t>
                                <br/>
                                <br/>

                                Here is the latest update on your
                                <strong>
                                    <t t-out="object.workflow_email_document_label()"/>
                                </strong>
                                request.
                                <br/>
                                <strong>Request Type:</strong>
                                <t t-out="object.workflow_email_document_label()"/>
                                <br/>
                                <strong>Reference Code:</strong>
                                <t t-out="object.workflow_email_reference_code()"/>
                                <br/>
                                <strong>Updated By:</strong>
                                <t t-out="ctx.get('workflow_actor_name') or object.write_uid.name or object.create_uid.name or 'Workflow System'"/>
                                <br/>
                                <strong>Current Stage:</strong>
                                <t t-out="object.workflow_email_current_stage_label()"/>
                                <br/>
                                <br/>
                                Please use the request link in this email to review the latest details.
                                <br/>
                                <br/>

                                Best regards,
                                <br/>
                                <strong>
                                    <t t-out="object.company_id.name if object.company_id else 'Workflow System'"/>
                                </strong>
                                <br/>
                                <span style="font-size: 11px; color: grey;">This is an automated message.</span>
                            </div>
                        </td>
                    </tr>
                </table>
            </field>
        </record>
    </data>
</odoo>
