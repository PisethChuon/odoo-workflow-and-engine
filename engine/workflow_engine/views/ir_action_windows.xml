<odoo>
    <record id="my_dashboard_action_window" model="ir.actions.act_window">
        <field name="name">My Workflow Dashboard</field>
        <field name="path">my-workflow-dashboard</field>
        <field name="res_model">workflow.approval.category</field>
        <field name="context">{'filter': 'MY_REQUESTS', 'search_default_non_child': 1}</field>
        <!-- <field name="domain">[('is_child', '=', False)]</field> -->
        <field name="view_mode">kanban,list</field>
        <field name="views" eval="[
            (ref('workflow_engine.workflow_approval_category_view_kanban'), 'kanban'),
            (ref('workflow_engine.workflow_approval_category_view_list_dashboard'), 'list'),
            (ref('workflow_engine.workflow_approval_category_view_form'), 'form')
        ]"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No Approvals Requests
            </p>
        </field>
    </record>
    
