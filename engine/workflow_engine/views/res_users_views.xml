  <record id="res_users_view_tree_workflow_picker" model="ir.ui.view">
    <field name="name">res.users.list.workflow.picker.flag</field>
    <field name="model">res.users</field>
    <field name="inherit_id" ref="base.view_users_tree"/>
    <field name="arch" type="xml">
      <xpath expr="//list/field[@name='login_date']" position="after">
        <field name="wf_hide_from_workflow_picker" widget="boolean_toggle"/>
      </xpath>
    </field>
  </record>

  <record id="view_res_users_request_owner_picker_list" model="ir.ui.view">
    <field name="name">res.users.request.owner.picker.list</field>
    <field name="model">res.users</field>
    <field name="arch" type="xml">
      <list string="Request Owners" create="false" edit="false">
        <field name="avatar_128" widget="image" options="{'size': [24, 24], 'img_class': 'o_avatar rounded'}" width="30" nolabel="1"/>
        <field name="wf_request_owner_emp_code" string="Emp Code"/>
        <field name="wf_request_owner_employee_name" string="Employee Name"/>
        <field name="wf_request_owner_department" string="Department"/>
        <field name="wf_request_owner_position" string="Position"/>
        <field name="wf_request_owner_extension" string="Extension"/>
        <field name="wf_request_owner_email" string="Work Email"/>
      </list>
    </field>
  </record>

  <record id="view_res_users_request_owner_picker_kanban" model="ir.ui.view">
    <field name="name">res.users.request.owner.picker.kanban</field>
    <field name="model">res.users</field>
    <field name="arch" type="xml">
      <kanban class="o_kanban_mobile" create="false" edit="false" quick_create="false">
        <field name="active"/>
        <field name="avatar_128"/>
        <field name="name"/>
        <field name="wf_request_owner_emp_code"/>
        <field name="wf_request_owner_employee_name"/>
        <field name="wf_request_owner_department"/>
        <field name="wf_request_owner_position"/>
        <field name="wf_request_owner_extension"/>
        <field name="wf_request_owner_email"/>
        <templates>
          <t t-name="card" class="flex-row align-items-start">
            <aside class="me-2 flex-shrink-0">
              <field name="avatar_128"
                     widget="image"
                     options="{'size': [48, 48], 'img_class': 'rounded'}"/>
            </aside>
            <main class="flex-grow-1 min-w-0">
              <div class="d-flex align-items-start justify-content-between gap-2">
                <div class="min-w-0 pe-1">
                  <div class="fw-bold text-truncate lh-sm">
                    <t t-if="record.wf_request_owner_employee_name.raw_value">
                      <field name="wf_request_owner_employee_name"/>
                    </t>
                    <t t-else="">
                      <field name="name"/>
                    </t>
                  </div>
                </div>
                <span t-if="record.active.raw_value"
                      class="badge rounded-pill text-bg-success flex-shrink-0">Active</span>
                <span t-else=""
                      class="badge rounded-pill text-bg-secondary flex-shrink-0">Archived</span>
              </div>

              <div class="d-flex flex-wrap align-items-center gap-2 small text-muted mt-1">
                <span t-if="record.wf_request_owner_emp_code.raw_value"
                      class="text-truncate">
                  <i class="fa fa-fw fa-id-badge me-1" title="Employee Code"/>
                  <field name="wf_request_owner_emp_code"/>
                </span>
                <span t-if="record.wf_request_owner_email.raw_value"
                      class="text-truncate">
                  <i class="fa fa-fw fa-envelope me-1" title="Work Email"/>
                  <field name="wf_request_owner_email"/>
                </span>
              </div>

              <div class="row g-2 mt-1 small">
                <div t-if="record.wf_request_owner_department.raw_value" class="col-12">
                  <span class="text-muted d-block">Department</span>
                  <div class="text-truncate fw-medium">
                    <field name="wf_request_owner_department"/>
                  </div>
                </div>
                <div t-if="record.wf_request_owner_position.raw_value" class="col-6">
                  <span class="text-muted d-block">Position</span>
                  <div class="text-truncate fw-medium">
                    <field name="wf_request_owner_position"/>
                  </div>
                </div>
                <div t-if="record.wf_request_owner_extension.raw_value" class="col-6">
                  <span class="text-muted d-block">Extension</span>
                  <div class="text-truncate fw-medium">
                    <field name="wf_request_owner_extension"/>
                  </div>
                </div>
              </div>
            </main>
          </t>
        </templates>
      </kanban>
    </field>
  </record>

  <record id="view_res_users_request_owner_picker_search" model="ir.ui.view">
    <field name="name">res.users.request.owner.picker.search</field>
    <field name="model">res.users</field>
    <field name="arch" type="xml">
      <search string="Request Owners">
        <field name="name"
               string="Owner"
               filter_domain="['|','|','|','|','|','|',
                               ('name', 'ilike', self),
                               ('login', 'ilike', self),
                               ('email', 'ilike', self),
                               ('partner_id.name', 'ilike', self),
                               ('partner_id.email', 'ilike', self),
                               ('employee_ids.name', 'ilike', self),
                               ('employee_ids.x_emp_code', 'ilike', self)]"/>
        <separator/>
        <filter name="request_owner_employee"
                string="Employee"
                domain="[('wf_request_owner_has_employee', '=', True)]"/>
        <filter name="request_owner_non_employee"
                string="Non Employee"
                domain="[('wf_request_owner_has_employee', '=', False)]"/>
        <separator/>
        <filter name="request_owner_group_department"
                string="Group by Department"
                domain="[]"
                context="{'group_by': 'wf_request_owner_department_id'}"/>
        <filter name="request_owner_group_position"
                string="Group by Position"
                domain="[]"
                context="{'group_by': 'wf_request_owner_job_id'}"/>
        <filter name="request_owner_group_employee"
                string="Group by Employee"
                domain="[]"
                context="{'group_by': 'wf_request_owner_employee_profile'}"/>
      </search>
    </field>
  </record>

