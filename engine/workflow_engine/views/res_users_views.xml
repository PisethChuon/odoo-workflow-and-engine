<?xml version='1.0' encoding='utf-8'?>
<odoo>
  <record id="res_users_view_form" model="ir.ui.view">
    <field name="name">hr.user.preferences.view.form.workflow.approval.inherit</field>
    <field name="model">res.users</field>
    <field name="inherit_id" ref="hr.res_users_view_form"/>
    <field name="arch" type="xml">
      <header position="inside">
        <button name="%(workflow_engine.approval_report_action_window)d" string="Request Approval" type="action" class="btn btn-primary"/>
      </header>
      <xpath expr="//page[@name='preferences']" position="after">
        <page name="workflow_preferences"
              string="Workflow"
              groups="workflow_engine.group_workflow_approval_user,workflow_engine.group_workflow_approval_admin,base.group_system">
          <group>
            <group string="Notifications">
              <field name="wf_approval_push_enabled" widget="boolean_toggle"/>
            </group>
            <group string="Out of Office">
              <field name="wf_ooo_enabled" widget="boolean_toggle"/>
              <button name="action_open_workflow_ooo_wizard"
                      string="Configure Delegation"
                      type="object"
                      class="btn-secondary"
                      invisible="not wf_ooo_enabled"/>
            </group>
          </group>
          <group groups="workflow_engine.group_workflow_approval_admin,workflow_engine.group_workflow_technical_admin,base.group_system">
            <group string="Workflow Selection">
              <field name="wf_hide_from_workflow_picker" widget="boolean_toggle"/>
            </group>
          </group>
          <group string="Current Out of Office Configuration" invisible="not wf_ooo_enabled">
            <group>
              <field name="wf_ooo_delegate_user_id"
                     readonly="1"
                     options="{'no_create': True, 'no_open': False}"/>
              <field name="wf_ooo_date_from" readonly="1"/>
              <field name="wf_ooo_date_to" readonly="1"/>
            </group>
            <group>
              <field name="wf_ooo_scope" readonly="1"/>
              <field name="wf_ooo_category_ids" widget="many2many_tags" readonly="1"/>
              <field name="wf_ooo_is_active_now" invisible="1"/>
            </group>
          </group>
          <notebook>
            <page string="Out of Office History" name="workflow_ooo_history" invisible="not wf_ooo_enabled">
              <field name="wf_ooo_delegation_history_ids" nolabel="1" mode="list,form">
                <list create="0" edit="0" delete="1">
                  <field name="active" string="Enabled" widget="boolean_toggle"/>
                  <field name="delegate_user_id" string="Assign To"/>
                  <field name="date_from" string="From"/>
                  <field name="date_to" string="To"/>
                  <field name="category_ids" string="Workflow Categories" widget="many2many_tags"/>
                  <field name="scope"/>
                  <field name="assignment_strategy" optional="hide"/>
                  <field name="delegation_source" optional="hide"/>
                  <field name="note" optional="hide"/>
                </list>
                <form string="Out of Office History" create="0" edit="0" delete="1">
                  <sheet>
                    <group>
                      <group>
                        <field name="delegator_user_id" string="User" readonly="1"/>
                        <field name="delegate_user_id" string="Assign To" readonly="1"/>
                        <field name="active" string="Enabled" widget="boolean_toggle" readonly="1"/>
                      </group>
                      <group>
                        <field name="date_from" string="From" readonly="1"/>
                        <field name="date_to" string="To" readonly="1"/>
                        <field name="scope" readonly="1"/>
                      </group>
                    </group>
                    <group>
                      <field name="category_ids" string="Workflow Categories" widget="many2many_tags" readonly="1"/>
                      <field name="assignment_strategy" readonly="1"/>
                      <field name="delegation_source" readonly="1"/>
                      <field name="note" readonly="1"/>
                    </group>
                  </sheet>
                </form>
              </field>
            </page>
          </notebook>
        </page>
      </xpath>
    </field>
  </record>

