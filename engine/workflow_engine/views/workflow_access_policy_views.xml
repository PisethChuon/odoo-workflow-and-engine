                                        <field name="scope_summary" readonly="1"/>
                                        <field name="department_ids" widget="many2many_tags" invisible="preset_scope != 'request_owner_department' or mode != 'preset'"/>
                                        <field name="request_owner_user_ids" widget="many2many_tags" invisible="preset_scope != 'request_owner_user' or mode != 'preset'"/>
                                        <field name="manager_user_ids" widget="many2many_tags" invisible="preset_scope != 'request_owner_manager' or mode != 'preset'"/>
                                        <field name="line_ids" widget="many2many_tags" invisible="preset_scope != 'request_owner_line' or mode != 'preset'"/>
