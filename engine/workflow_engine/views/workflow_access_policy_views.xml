                                <field name="access_level"/>
                                <field name="mode"/>
                                <field name="preset_scope" invisible="mode != 'preset'"/>
                                <field name="scope_summary" readonly="1"/>
                            </list>
                            <form string="Read Visibility Rule">
                                <group>
                                    <group>
