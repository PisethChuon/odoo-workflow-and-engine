                            Use <strong>Restricted</strong> only when only selected users, groups, or departments may start this category.
                            Starting a request does not mean the user can read every existing request.
                        </div>
                        <group>
                            <field name="security_policy_draft_create_access_mode" string="Request Creation Access"/>
                        </group>
                        <group invisible="security_policy_draft_create_access_mode != 'restricted'">
                            <field name="security_policy_draft_create_allowed_user_ids" string="Create Allowed Users" widget="many2many_tags"/>
                            <field name="security_policy_draft_create_allowed_group_ids" string="Create Allowed Groups" widget="many2many_tags"/>
