    <record id="workflow_approval_category_view_form_access_policy" model="ir.ui.view">
        <field name="name">workflow.approval.category.view.form.security.policy</field>
        <field name="model">workflow.approval.category</field>
        <field name="inherit_id" ref="workflow_engine.workflow_approval_category_view_form"/>
        <field name="active" eval="False"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="Policy Workspace" groups="workflow_engine.group_workflow_approval_admin,workflow_engine.group_workflow_technical_admin,base.group_system">
                    <group>
                        <div class="alert alert-primary" colspan="2" role="alert">
                            <strong>Policy workspace and publish flow.</strong>
                            Reusable templates are managed globally in <strong>Configuration &gt; Security Policy Templates</strong>.
                            This page is the working copy for the selected category, along with publish status and category-specific overrides after a template is applied.
                            Use <strong>Load Template to Draft</strong> to prepare working-copy values, then <strong>Publish Changes</strong> to make them active.
                        </div>
                    </group>
                    <group>
                        <group string="Template and Publish Status">
                            <field name="access_policy_template_id" string="Security Policy Template" readonly="1"/>
                            <field name="access_policy_last_applied_at" readonly="1"/>
                            <field name="access_policy_last_applied_by" readonly="1"/>
                            <field name="security_policy_last_published_at" readonly="1"/>
                            <field name="security_policy_last_published_by" readonly="1"/>
