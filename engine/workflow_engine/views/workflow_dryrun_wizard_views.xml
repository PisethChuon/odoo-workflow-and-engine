<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_workflow_dryrun_wizard_form" model="ir.ui.view">
        <field name="name">workflow.dryrun.wizard.form</field>
        <field name="model">workflow.dryrun.wizard</field>
        <field name="arch" type="xml">
            <form string="Workflow Dry Run">
                <sheet>
                    <div class="o_form_label mb-3">
                        <h4>Workflow Dry Run</h4>
                        <p class="text-muted mb-0">
                            Simulate assignment resolution and domain diagnostics directly in this modal.
                        </p>
                    </div>

                    <group string="Simulation Session">
                        <group>
                            <field name="category_id" options="{'no_create': True, 'no_open': True}"/>
                            <field name="version_id"
                                   options="{'no_create': True, 'no_open': True}"
                                   domain="[('category_id', '=', category_id)]"/>
                        </group>
                        <group>
                            <field name="simulated_user_id"
                                   string="Request Owner / Submitter"
                                   options="{'no_create': True, 'no_create_edit': True, 'no_quick_create': True, 'no_open': True}"/>
                            <field name="target_model_name" readonly="1"/>
                            <field name="has_snapshot" invisible="1"/>
                            <field name="has_results" invisible="1"/>
                        </group>
                    </group>

                    <notebook>
                        <page string="Node Inputs">
                            <p class="text-muted">
                                Optional: simulate users assigned to or decided at each workflow stage.
                                Later stages use these values for previous-actor and node-user domain rules.
                            </p>
                            <field name="node_input_ids" nolabel="1" context="{'default_wizard_id': id}">
                                <list create="false" delete="false" open_form_view="true">
                                    <field name="node_name" readonly="1"/>
                                    <field name="node_id" optional="show" readonly="1"/>
                                    <field name="node_type" optional="show" readonly="1"/>
                                    <field name="assigned_user_ids"
                                           string="Stage Assigned Users"
                                           widget="many2many_tags"
                                           options="{'no_create': True, 'no_create_edit': True, 'no_quick_create': True, 'no_open': True}"/>
                                    <field name="decided_user_ids"
                                           string="Stage Decided Users"
                                           widget="many2many_tags"
                                           options="{'no_create': True, 'no_create_edit': True, 'no_quick_create': True, 'no_open': True}"/>
                                </list>
                                <form string="Simulated Node Users" create="false" delete="false">
                                    <sheet>
                                        <field name="wizard_id" invisible="1" force_save="1"/>
                                        <group string="Workflow Node">
                                            <group>
                                                <field name="node_name" readonly="1"/>
                                                <field name="node_id" readonly="1"/>
                                            </group>
                                            <group>
                                                <field name="node_type" readonly="1"/>
                                            </group>
                                        </group>
                                        <group string="Stage History Users">
                                            <field name="assigned_user_ids"
                                                   string="Assigned at This Stage"
                                                   widget="many2many_tags"
                                                   options="{'no_create': True, 'no_create_edit': True, 'no_quick_create': True, 'no_open': True}"/>
                                            <field name="decided_user_ids"
                                                   string="Decided at This Stage"
                                                   widget="many2many_tags"
                                                   options="{'no_create': True, 'no_create_edit': True, 'no_quick_create': True, 'no_open': True}"/>
                                        </group>
                                    </sheet>
                                </form>
                            </field>
                        </page>

                        <page string="Form Values">
                            <p class="text-muted">
                                Add only the request fields used by assignment domains. For example, choose
                                <strong>x_nurse_id</strong> and select the nurse employee to test nurse routing.
                            </p>
                            <field name="field_input_ids" nolabel="1" context="{'default_wizard_id': id}">
                                <list create="true" delete="true" open_form_view="true">
                                    <field name="field_label"/>
                                    <field name="field_name" optional="show"/>
                                    <field name="field_type"/>
                                    <field name="relation" optional="show"/>
                                    <field name="value_display"/>
                                </list>
                                <form string="Dry Run Form Value">
                                    <sheet>
                                        <field name="wizard_id" invisible="1" force_save="1"/>
                                        <group string="Field">
                                            <field name="target_model_name" readonly="1"/>
                                            <field name="field_id"
                                                   options="{'no_create': True, 'no_open': True}"/>
                                            <field name="field_name" readonly="1"/>
                                            <field name="field_type" readonly="1"/>
                                            <field name="relation" readonly="1" invisible="field_type != 'many2one'"/>
                                        </group>
                                        <group string="Value">
                                            <field name="value_char"
                                                   invisible="field_type not in ('char', 'selection')"/>
                                            <field name="value_text"
                                                   invisible="field_type not in ('text', 'html')"/>
                                            <field name="value_boolean"
                                                   invisible="field_type != 'boolean'"/>
                                            <field name="value_integer"
                                                   string="Integer / Related Record ID"
                                                   invisible="field_type != 'integer' and (field_type != 'many2one' or relation in ('res.users', 'hr.employee', 'res.partner'))"/>
                                            <field name="value_float"
                                                   invisible="field_type not in ('float', 'monetary')"/>
                                            <field name="value_date"
                                                   invisible="field_type != 'date'"/>
                                            <field name="value_datetime"
                                                   invisible="field_type != 'datetime'"/>
                                            <field name="value_user_id"
                                                   invisible="field_type != 'many2one' or relation != 'res.users'"
                                                   options="{'no_create': True, 'no_create_edit': True, 'no_quick_create': True, 'no_open': True}"/>
                                            <field name="value_employee_id"
                                                   invisible="field_type != 'many2one' or relation != 'hr.employee'"
                                                   options="{'no_create': True, 'no_create_edit': True, 'no_quick_create': True, 'no_open': True}"/>
                                            <field name="value_partner_id"
                                                   invisible="field_type != 'many2one' or relation != 'res.partner'"
                                                   options="{'no_create': True, 'no_create_edit': True, 'no_quick_create': True, 'no_open': True}"/>
                                        </group>
                                    </sheet>
                                </form>
                            </field>
                        </page>

                        <page string="Advanced JSON">
                            <p class="text-muted">
                                Optional raw overrides for edge cases that are not covered by the typed field inputs.
                            </p>
                            <field name="snapshot_json"
                                   nolabel="1"
                                   widget="json_format"
                                   options="{'rows': 10, 'indent': 2}"/>
                        </page>

                        <page string="Stage Results" invisible="not has_results">
                            <field name="result_line_ids" nolabel="1">
                                <list decoration-danger="status in ('blocked', 'config_error')"
                                      decoration-warning="status in ('warning', 'needs_input', 'fallback')"
                                      decoration-muted="status == 'system'">
                                    <field name="sequence" string="#"/>
                                    <field name="node_name"/>
                                    <field name="node_type" optional="show"/>
                                    <field name="assignment_mode_label" string="Mode"/>
                                    <field name="assignee_user_ids" widget="many2many_tags"/>
                                    <field name="notification_recipient_user_ids"
                                           widget="many2many_tags"
                                           optional="show"/>
                                    <field name="assignee_count" string="Count"/>
                                    <field name="notification_recipient_count"
                                           string="Notify"
                                           optional="show"/>
                                    <field name="status_label" string="Status"/>
                                    <field name="diagnosis"/>
                                    <field name="status" column_invisible="1"/>
                                </list>

                                <form string="Dry Run Result">
                                    <sheet>
                                        <group string="Stage">
                                            <group>
                                                <field name="sequence" readonly="1"/>
                                                <field name="node_name" readonly="1"/>
                                                <field name="node_id" readonly="1"/>
                                                <field name="node_type" readonly="1"/>
                                            </group>
                                            <group>
                                                <field name="assignment_mode_label" readonly="1"/>
                                                <field name="fallback_policy_label" readonly="1"/>
                                                <field name="status_label" readonly="1"/>
                                                <field name="diagnosis" readonly="1"/>
                                            </group>
                                        </group>

                                        <group string="Resolution">
                                            <group>
                                                <field name="candidate_count" readonly="1"/>
                                                <field name="eligible_count" readonly="1"/>
                                                <field name="assignee_count" readonly="1"/>
                                            </group>
                                            <group>
                                                <field name="is_blocked" readonly="1"/>
                                                <field name="status" readonly="1"/>
                                                <field name="notification_delivery_mode"
                                                       readonly="1"
                                                       invisible="not notification_has_result"/>
                                                <field name="notification_recipient_count"
                                                       readonly="1"
                                                       invisible="not notification_has_result"/>
                                            </group>
                                        </group>

                                        <notebook>
                                            <page string="Assignees">
                                                <field name="assignee_user_ids" nolabel="1" readonly="1">
                                                    <list>
                                                        <field name="name"/>
                                                        <field name="login"/>
                                                        <field name="job_title" optional="show"/>
                                                        <field name="company_id" optional="show"/>
                                                    </list>
                                                </field>
                                            </page>
                                            <page string="Notification" invisible="not notification_has_result">
                                                <group string="Resolved Notification Recipients" col="12">
                                                    <field name="notification_recipient_user_ids"
                                                           nolabel="1"
                                                           readonly="1"
                                                           colspan="12">
                                                        <list>
                                                            <field name="name"/>
                                                            <field name="login"/>
                                                            <field name="email" optional="show"/>
                                                            <field name="company_id" optional="show"/>
                                                        </list>
                                                    </field>
                                                </group>
                                                <group string="Email Headers" col="12">
                                                    <field name="notification_email_to" readonly="1" colspan="12"/>
                                                    <field name="notification_email_cc" readonly="1" colspan="12"/>
                                                    <field name="notification_email_bcc" readonly="1" colspan="12"/>
                                                </group>
                                                <group string="Notification Debug" col="12">
                                                    <field name="notification_debug_json"
                                                           nolabel="1"
                                                           widget="json_format"
                                                           options="{'rows': 18, 'indent': 2}"
                                                           readonly="1"
                                                           colspan="12"/>
                                                </group>
                                            </page>
                                            <page string="Warnings" invisible="not warnings">
                                                <field name="warnings" nolabel="1" readonly="1"/>
                                            </page>
                                            <page string="Delegation" invisible="not delegation_info">
                                                <field name="delegation_info" nolabel="1" readonly="1"/>
                                            </page>
                                            <page string="Debug">
                                                <field name="debug_json"
                                                       nolabel="1"
                                                       widget="json_format"
                                                       options="{'rows': 18, 'indent': 2}"
                                                       readonly="1"/>
                                            </page>
                                        </notebook>
                                    </sheet>
                                </form>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <footer>
                    <button name="action_run_dryrun"
                            type="object"
                            string="Run Dry Run"
                            class="btn-primary"/>
                    <button special="cancel" string="Close" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_workflow_dryrun_wizard" model="ir.actions.act_window">
        <field name="name">Workflow Dry Run</field>
        <field name="res_model">workflow.dryrun.wizard</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="view_workflow_dryrun_wizard_form"/>
        <field name="target">new</field>
    </record>

</odoo>
