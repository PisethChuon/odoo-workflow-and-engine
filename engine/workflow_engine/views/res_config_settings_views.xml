<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_workflow_engine_settings" model="ir.actions.act_window">
        <field name="name">Settings</field>
        <field name="res_model">res.config.settings</field>
        <field name="view_mode">form</field>
        <field name="context">{'module': 'workflow_engine', 'bin_size': False}</field>
    </record>

    <record id="res_config_settings_view_form_workflow_engine" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.workflow.engine</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form" position="inside">
                <t groups="base.group_system">
                    <app data-string="Workflow" string="Workflow" name="workflow_engine">
                        <block title="Notifications">
                            <setting string="Default Owner Update Email Template"
                                     help="Fallback template for the built-in owner update email when the workflow version does not define an override.">
                                <field name="workflow_default_owner_notification_template_id"
                                       domain="[('model_id.model', '=', 'workflow.base.approval.request')]"
                                       options="{'no_create': True}"/>
                            </setting>
                        </block>
                        <block title="Runtime Authorization">
                            <setting string="Business Action Actors"
                                     help="Enable opt-in action rights such as owner-only Cancel without creating approver rows.">
                                <field name="workflow_business_action_actor_enabled"/>
                            </setting>
                        </block>
                    </app>
                </t>
            </xpath>
        </field>
    </record>
</odoo>
