    <record id="workflow_approval_request_action_to_review_category" model="ir.actions.act_window">
        <field name="name">Approvals to review</field>
        <field name="res_model">workflow.base.approval.request</field>
        <field name="view_mode">list,form,kanban</field>
        <field name="domain">[
            ('category_id', '=', active_id),
            ('is_my_work_item', '=', True)
        ]</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No new approvals to review
            </p>
        </field>
    </record>

    <record id="workflow_approval_category_view_search" model="ir.ui.view">
        <field name="name">workflow.approval.category.search</field>
        <field name="model">workflow.approval.category</field>
        <field name="priority">10</field>
        <field name="arch" type="xml">
            <search>
                <field name="name" />
                <field name="department_id" />
                <field name="company_id" />
                <separator />
                <filter name="archived" string="Archived" domain="[('active', '=', False)]" />
                <searchpanel class="w-auto">
                    <field name="department_id" icon="fa-users" enable_counters="1" />
                </searchpanel>

                <filter name="non_child" string="Workflow"
                    domain="[('is_child', '=', False)]" />
                <filter name="child" string="Sub Worklfow"
                    domain="[('is_child', '=', True)]" />
                <separator/>
                <filter name="groupby_department" string="Group by Department" domain="[]"
                    context="{'group_by': 'department_id'}"/>
                <filter name="groupby_model" string="Group by Model" domain="[]"
                    context="{'group_by': 'res_model'}"/>
            </search>
        </field>
    </record>

    <record id="workflow_approval_category_view_list_dashboard" model="ir.ui.view">
        <field name="name">workflow.approval.category.view.list.dashboard</field>
        <field name="model">workflow.approval.category</field>
        <field name="priority">30</field>
        <field name="arch" type="xml">
            <list create="false" default_order="sequence, create_date, id">
                <field name="image" widget="image" options="{'size': [32, 32]}" string=""/>
                <field name="name" string="Workflow Category"/>
                <field name="department_id" optional="show"/>
                <field name="res_model_name" string="Model" optional="show"/>
                <field name="request_all_count" string="Total"/>
                <field name="request_tosubmit_count" string="New" optional="show"/>
                <field name="request_waiting_count" string="In Progress"/>
                <field name="request_reviewed_count" string="Reviewed" optional="show"/>
                <field name="request_completed_count" string="Done" optional="show"/>
                <field name="active_version_id" string="Active Version" optional="hide"/>
                <field name="can_create_request" column_invisible="1"/>
                <button type="object" name="action_approval_category" string="Open Requests" class="btn btn-primary"/>
                <button type="object" name="action_new_request" string="New Request" class="btn btn-secondary"
                        invisible="not can_create_request"/>
            </list>
        </field>
    </record>

    <record id="workflow_approval_category_view_form" model="ir.ui.view">
        <field name="name">workflow.approval.category.view.form</field>
        <field name="model">workflow.approval.category</field>
        <field name="priority">10</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger"
                        invisible="active" />
                    <field name="image" widget="image" class="oe_avatar"
                        options='{"preview_image": "image", "size": [80, 80]}' />
                    <div class="oe_button_box" name="button_box">
                        <button type="object" name="action_open_dryrun_wizard"
                                class="oe_stat_button" icon="fa-flask"
                                groups="workflow_engine.group_workflow_technical_admin"
                                string="Dry Run"
                                help="Simulate assignment resolution for each workflow node without affecting real data."/>
                    </div>
                    <div class="oe_title">
                        <label for="name" string="Approval Type" />
                        <h1>
                            <field name="name" placeholder="e.g. Procurement" />
                        </h1>
                    </div>
                    <group>
                        <field name="res_model" />
                        <field name="res_model_name" invisible="1"/>
                        <field name="active_version_id"
                            groups="workflow_engine.group_workflow_approval_admin" readonly="1" />
                        <field name="department_id" />
                        <field name="description" />
                        <field name="approval_type" invisible="1" />
                        <field name="automated_sequence" />
                        <field name="sequence_code" invisible="not automated_sequence"
                            required="automated_sequence" />
                        <field name="company_id" options="{'no_create': True}"
                            groups="base.group_multi_company" />
                        <field name="allowed_duplicate"/>
                        <field name="allow_duplicate_domain"
                               string="Duplicate Block Domain"
                               widget="domain"
                               options="{'model': 'res_model_name', 'in_dialog': true}"
                               invisible="allowed_duplicate"/>
                        <field name="enable_request_history"/>
                        <field name="request_history_domain"
                               string="History Domain"
                               widget="domain"
                               options="{'model': 'res_model_name', 'in_dialog': true}"
                               invisible="not enable_request_history"/>
                        <field name="auto_cancel_timeout" />
                        <field name="admin_group_ids"
                               widget="many2many_tags"
                               groups="workflow_engine.group_workflow_technical_admin,workflow_engine.group_workflow_approval_admin,base.group_system"/>
                    </group>
                    <notebook>
                        <page string="Guide">
                            <group>
                                <field name="guide_html"
                                       widget="html"
                                       placeholder="Add workflow introduction, user instructions, flow notes, and references..."/>
                            </group>
                        </page>
                        <page string="Versions">
                            <field name="version_ids" widget="one2many" mode="list,kanban">
                                <list>
                                    <field name="name" readonly="1" />
                                    <field name="is_locked" />
                                    <field name="is_active" />
                                    <button name="action_set_active" string="Deploy" type="object"
                                        invisible="is_active"
                                        class="btn-primary" />
                                </list>
                            </field>
                        </page>
                        <!-- <page string="Options" name="options">
                            <group>
                                <group string="Approvers" name="approvers">
                                    <field name="manager_approval"/>
                                    <separator colspan="2"/>
                                    <field name="approver_ids"/>
                                    <field name="approver_sequence" invisible="approval_minimum == 0"/>
                                    <field name="approval_minimum"/>
                                    <field name="invalid_minimum" invisible="1"/>
                                    <div class="text-warning" colspan="2" invisible="not invalid_minimum">
                                        <span class="fa fa-warning" title="Invalid minimum approvals"/>
                                        <field name="invalid_minimum_warning" nolabel="1"/>
                                    </div>
                                </group>
                            </group>
                        </page> -->

                        <page string="Diagram">
                            <group>
                                <field nolabel="1" name="bpmn_xml" readonly="1" widget="bpmn_widget" />
                            </group>
                        </page>
                        <page string="Raw Diagram">
                            <group>
                                <field nolabel="1" readonly="1" name="bpmn_xml" widget="code"
                                    options="{'mode': 'xml'}" />
                            </group>
                        </page>
                        <page string="Automation">
                            <field name="automation_action_ids" widget="one2many">
                                <list action="action_open_automation_actions">
                                    <field name="name" />
                                    <field name="model_id" />
                                    <field name="active" />
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="workflow_approval_category_guide_modal_view" model="ir.ui.view">
        <field name="name">workflow.approval.category.guide.modal.view</field>
        <field name="model">workflow.approval.category</field>
        <field name="arch" type="xml">
            <form string="Workflow Guide" create="false" edit="false" delete="false">
                <sheet>
                    <div class="oe_title">
                        <h2>
                            <field name="name" readonly="1"/>
                        </h2>
                    </div>
                    <div class="text-muted" invisible="guide_html">
                        No guide is configured for this workflow yet.
                    </div>
                    <field name="guide_html" widget="html" readonly="1" nolabel="1" invisible="not guide_html"/>
                </sheet>
                <footer>
                    <button string="Close" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>


    <record id="action_open_approval_category" model="ir.actions.server">
        <field name="name">Open Approval Category</field>
        <field name="model_id" ref="model_workflow_approval_category" />
        <field name="state">code</field>
        <field name="code">
            action = {
            "type": "ir.actions.act_window",
            "res_model": "workflow.approval.category",
            "views": [[False, "form"]],
            "target": "new",
            "res_id": records.id,
            }
        </field>
    </record>

