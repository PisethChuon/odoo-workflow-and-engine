<odoo>
    <record id="view_workflow_approval_action_form" model="ir.ui.view">
        <field name="name">workflow.approval.action.form</field>
        <field name="model">workflow.approval.action</field>
        <field name="arch" type="xml">
            <form string="Workflow Approval Action">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="action_type"/>
                        <field name="version_id" readonly="1" options="{'no_open': True}"/>
                        <field name="res_model_id" invisible="1"/>
                        <field name="res_model_name" readonly="1"/>
                        <field name="domain"
                               widget="domain"
                               options="{'model': 'res_model_name', 'in_dialog': true}"/>
                        <field name="domain_string"/>
                    </group>
                    <notebook>
                        <page string="Email">
                            <group>
                                <field name="email_template_id"
                                    domain="[('model_id','=',res_model_id)]"
                                    invisible="action_type != 'email'"/>
                            </group>
                        </page>

                        <page string="SMS / Telegram">
                            <group>
                                <field name="message_body" invisible="action_type not in ['sms', 'telegram']"/>
                                <field name="telegram_webhook_url" invisible="action_type != 'telegram'"/>
                            </group>
                        </page>

                        <page string="Webhook">
                            <group>
                                <field name="webhook_url" invisible="action_type not in ['webhook', 'telegram']"/>
                            </group>
                        </page>

                        <page string="Server Action">
                            <group>
                                <field name="server_action_id"
                                    invisible="action_type != 'server_action'"
                                    domain="[('model_id', '=', res_model_id)]"/>
                            </group>
                        </page>

                        <page string="Workflow Code">
                            <group>
                                <field name="code" widget="text" options="{'mode': 'python'}"
                                    invisible="action_type != 'workflow'"/>
                            </group>
                        </page>

                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_workflow_approval_action_list" model="ir.ui.view">
        <field name="name">workflow.approval.action.list</field>
        <field name="model">workflow.approval.action</field>
        <field name="arch" type="xml">
            <list string="Workflow Actions">
                <field name="name"/>
                <field name="action_type"/>
                <field name="email_template_id"/>
                <field name="server_action_id"/>
                <field name="telegram_webhook_url"/>
                <field name="webhook_url"/>
            </list>
        </field>
    </record>

    <record id="view_workflow_approval_action_search" model="ir.ui.view">
        <field name="name">workflow.approval.action.search</field>
        <field name="model">workflow.approval.action</field>
        <field name="arch" type="xml">
            <search string="Workflow Actions">
                <field name="name"/>
                <field name="action_type"/>
            </search>
        </field>
    </record>

    <record id="action_workflow_approval_action" model="ir.actions.act_window">
        <field name="name">Approval Actions</field>
        <field name="res_model">workflow.approval.action</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
