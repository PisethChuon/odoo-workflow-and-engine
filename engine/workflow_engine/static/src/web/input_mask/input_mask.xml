<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
  <t t-name="workflow_engine.InputMaskField" t-inherit="web.CharField">
    <xpath expr="//input" position="replace">
      <input
          class="o_input"
          t-att-class="{
              'o_field_translate': isTranslatable,
              'o_field_placeholder': hasDynamicPlaceholder
          }"
          t-att-id="props.id"
          t-att-type="props.isPassword ? 'password' : 'text'"
          t-att-autocomplete="props.autocomplete or (props.isPassword ? 'new-password' : 'off')"
          t-att-maxlength="maxLength > 0 and maxLength"
          t-att-placeholder="props.placeholder || _displayMaskTemplate(props.mask || '')"
          t-on-blur="onBlur"
          t-ref="input"
      />
    </xpath>
  </t>
</templates>
