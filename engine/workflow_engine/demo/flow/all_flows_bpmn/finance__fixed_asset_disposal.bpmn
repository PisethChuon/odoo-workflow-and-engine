    <bpmn:sequenceFlow id="Flow_05_Pdb500579" sourceRef="Event_Approve_Pdb500579" targetRef="Gateway_Route_Pdb500579" />

    <bpmn:sequenceFlow id="Flow_06_Pdb500579" sourceRef="Gateway_Route_Pdb500579" targetRef="Task_AdditionalApproval_Pdb500579">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">[('need_additional_approval', '=', True)]</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_07_Pdb500579" sourceRef="Task_AdditionalApproval_Pdb500579" targetRef="Event_AdditionalApprove_Pdb500579" />
    <bpmn:sequenceFlow id="Flow_08_Pdb500579" sourceRef="Event_AdditionalApprove_Pdb500579" targetRef="EndEvent_Completed_Pdb500579" />
    <bpmn:sequenceFlow id="Flow_09_Pdb500579" sourceRef="Gateway_Route_Pdb500579" targetRef="EndEvent_Completed_Pdb500579" />

    <bpmn:sequenceFlow id="Flow_10_Pdb500579" sourceRef="Task_HODApproval_Pdb500579" targetRef="Event_Rework_Pdb500579" />
    <bpmn:sequenceFlow id="Flow_11_Pdb500579" sourceRef="Event_Rework_Pdb500579" targetRef="Task_RequestorRework_Pdb500579" />
    <bpmn:sequenceFlow id="Flow_12_Pdb500579" sourceRef="Task_RequestorRework_Pdb500579" targetRef="Event_Resubmit_Pdb500579" />
    <bpmn:sequenceFlow id="Flow_13_Pdb500579" sourceRef="Event_Resubmit_Pdb500579" targetRef="Task_HODApproval_Pdb500579" />

