  <bpmn:process id="Process_Pdb500579" name="Fixed Asset Disposal" isExecutable="true">
    <bpmn:startEvent id="StartEvent_Pdb500579" name="Start" />

    <bpmn:userTask id="Task_Submission_Pdb500579" name="Submitter - Draft and Submit" />
    <bpmn:intermediateCatchEvent id="Event_Submit_Pdb500579" name="Submit">
      <bpmn:messageEventDefinition id="MessageDef_Submit_Pdb500579" />
    </bpmn:intermediateCatchEvent>

    <bpmn:userTask id="Task_HODApproval_Pdb500579" name="HOD Approval" />
    <bpmn:intermediateCatchEvent id="Event_Approve_Pdb500579" name="Approve">
      <bpmn:messageEventDefinition id="MessageDef_Approve_Pdb500579" />
    </bpmn:intermediateCatchEvent>
    <bpmn:exclusiveGateway id="Gateway_Route_Pdb500579" name="Conditional Route" default="Flow_09_Pdb500579" />

    <bpmn:userTask id="Task_AdditionalApproval_Pdb500579" name="Additional Approval" />
    <bpmn:intermediateCatchEvent id="Event_AdditionalApprove_Pdb500579" name="Approve Additional">
      <bpmn:messageEventDefinition id="MessageDef_AddApprove_Pdb500579" />
    </bpmn:intermediateCatchEvent>

    <bpmn:intermediateThrowEvent id="Event_Rework_Pdb500579" name="Rework" />
    <bpmn:userTask id="Task_RequestorRework_Pdb500579" name="Requestor Rework" />
    <bpmn:intermediateCatchEvent id="Event_Resubmit_Pdb500579" name="Resubmit">
      <bpmn:messageEventDefinition id="MessageDef_Resubmit_Pdb500579" />
    </bpmn:intermediateCatchEvent>

    <bpmn:intermediateThrowEvent id="Event_Reject_Pdb500579" name="Reject" />

    <bpmn:endEvent id="EndEvent_Completed_Pdb500579" name="Completed" />
    <bpmn:endEvent id="EndEvent_Rejected_Pdb500579" name="Rejected" />

    <bpmn:sequenceFlow id="Flow_01_Pdb500579" sourceRef="StartEvent_Pdb500579" targetRef="Task_Submission_Pdb500579" />
    <bpmn:sequenceFlow id="Flow_02_Pdb500579" sourceRef="Task_Submission_Pdb500579" targetRef="Event_Submit_Pdb500579" />
    <bpmn:sequenceFlow id="Flow_03_Pdb500579" sourceRef="Event_Submit_Pdb500579" targetRef="Task_HODApproval_Pdb500579" />
