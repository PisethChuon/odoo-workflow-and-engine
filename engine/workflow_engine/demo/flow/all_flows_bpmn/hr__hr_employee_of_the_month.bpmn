  id="Definitions_Peedaaf65"
  targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:process id="Process_Peedaaf65" name="HR Employee Of the month" isExecutable="true">
    <bpmn:startEvent id="StartEvent_Peedaaf65" name="Start" />

    <bpmn:userTask id="Task_Submission_Peedaaf65" name="Submitter - Draft and Submit" />
    <bpmn:intermediateCatchEvent id="Event_Submit_Peedaaf65" name="Submit">
      <bpmn:messageEventDefinition id="MessageDef_Submit_Peedaaf65" />
    </bpmn:intermediateCatchEvent>

    <bpmn:userTask id="Task_HODApproval_Peedaaf65" name="HOD Approval" />
    <bpmn:intermediateCatchEvent id="Event_Approve_Peedaaf65" name="Approve">
      <bpmn:messageEventDefinition id="MessageDef_Approve_Peedaaf65" />
    </bpmn:intermediateCatchEvent>
    <bpmn:exclusiveGateway id="Gateway_Route_Peedaaf65" name="Conditional Route" default="Flow_09_Peedaaf65" />

    <bpmn:userTask id="Task_AdditionalApproval_Peedaaf65" name="Additional Approval" />
    <bpmn:intermediateCatchEvent id="Event_AdditionalApprove_Peedaaf65" name="Approve Additional">
      <bpmn:messageEventDefinition id="MessageDef_AddApprove_Peedaaf65" />
    </bpmn:intermediateCatchEvent>

    <bpmn:intermediateThrowEvent id="Event_Rework_Peedaaf65" name="Rework" />
    <bpmn:userTask id="Task_RequestorRework_Peedaaf65" name="Requestor Rework" />
    <bpmn:intermediateCatchEvent id="Event_Resubmit_Peedaaf65" name="Resubmit">
      <bpmn:messageEventDefinition id="MessageDef_Resubmit_Peedaaf65" />
    </bpmn:intermediateCatchEvent>

    <bpmn:intermediateThrowEvent id="Event_Reject_Peedaaf65" name="Reject" />

    <bpmn:endEvent id="EndEvent_Completed_Peedaaf65" name="Completed" />
    <bpmn:endEvent id="EndEvent_Rejected_Peedaaf65" name="Rejected" />

    <bpmn:sequenceFlow id="Flow_01_Peedaaf65" sourceRef="StartEvent_Peedaaf65" targetRef="Task_Submission_Peedaaf65" />
    <bpmn:sequenceFlow id="Flow_02_Peedaaf65" sourceRef="Task_Submission_Peedaaf65" targetRef="Event_Submit_Peedaaf65" />
    <bpmn:sequenceFlow id="Flow_03_Peedaaf65" sourceRef="Event_Submit_Peedaaf65" targetRef="Task_HODApproval_Peedaaf65" />
    <bpmn:sequenceFlow id="Flow_04_Peedaaf65" sourceRef="Task_HODApproval_Peedaaf65" targetRef="Event_Approve_Peedaaf65" />
    <bpmn:sequenceFlow id="Flow_05_Peedaaf65" sourceRef="Event_Approve_Peedaaf65" targetRef="Gateway_Route_Peedaaf65" />

    <bpmn:sequenceFlow id="Flow_06_Peedaaf65" sourceRef="Gateway_Route_Peedaaf65" targetRef="Task_AdditionalApproval_Peedaaf65">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">[('need_additional_approval', '=', True)]</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_07_Peedaaf65" sourceRef="Task_AdditionalApproval_Peedaaf65" targetRef="Event_AdditionalApprove_Peedaaf65" />
    <bpmn:sequenceFlow id="Flow_08_Peedaaf65" sourceRef="Event_AdditionalApprove_Peedaaf65" targetRef="EndEvent_Completed_Peedaaf65" />
    <bpmn:sequenceFlow id="Flow_09_Peedaaf65" sourceRef="Gateway_Route_Peedaaf65" targetRef="EndEvent_Completed_Peedaaf65" />

    <bpmn:sequenceFlow id="Flow_10_Peedaaf65" sourceRef="Task_HODApproval_Peedaaf65" targetRef="Event_Rework_Peedaaf65" />
    <bpmn:sequenceFlow id="Flow_11_Peedaaf65" sourceRef="Event_Rework_Peedaaf65" targetRef="Task_RequestorRework_Peedaaf65" />
    <bpmn:sequenceFlow id="Flow_12_Peedaaf65" sourceRef="Task_RequestorRework_Peedaaf65" targetRef="Event_Resubmit_Peedaaf65" />
    <bpmn:sequenceFlow id="Flow_13_Peedaaf65" sourceRef="Event_Resubmit_Peedaaf65" targetRef="Task_HODApproval_Peedaaf65" />

    <bpmn:sequenceFlow id="Flow_14_Peedaaf65" sourceRef="Task_HODApproval_Peedaaf65" targetRef="Event_Reject_Peedaaf65" />
    <bpmn:sequenceFlow id="Flow_15_Peedaaf65" sourceRef="Event_Reject_Peedaaf65" targetRef="EndEvent_Rejected_Peedaaf65" />
  </bpmn:process>

