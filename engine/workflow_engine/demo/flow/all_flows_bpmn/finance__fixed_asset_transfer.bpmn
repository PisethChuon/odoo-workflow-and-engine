  <bpmn:process id="Process_Pe9d7cb5b" name="Fixed Asset Transfer" isExecutable="true">
    <bpmn:startEvent id="StartEvent_Pe9d7cb5b" name="Start" />

    <bpmn:userTask id="Task_Submission_Pe9d7cb5b" name="Submitter - Draft and Submit" />
    <bpmn:intermediateCatchEvent id="Event_Submit_Pe9d7cb5b" name="Submit">
      <bpmn:messageEventDefinition id="MessageDef_Submit_Pe9d7cb5b" />
    </bpmn:intermediateCatchEvent>

    <bpmn:userTask id="Task_HODApproval_Pe9d7cb5b" name="HOD Approval" />
