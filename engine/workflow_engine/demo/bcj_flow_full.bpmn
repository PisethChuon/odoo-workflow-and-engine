<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  id="Definitions_BCJ"
                  targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:process id="Process_BCJ" name="Business Case Justification" isExecutable="true">

    <bpmn:startEvent id="StartEvent_BCJ" name="Start"/>

    <bpmn:userTask id="Task_Submitter" name="Submitter - Draft and Submit"/>
    <bpmn:intermediateCatchEvent id="Event_Submit" name="Submit">
      <bpmn:messageEventDefinition id="MessageDef_Submit"/>
    </bpmn:intermediateCatchEvent>

    <bpmn:userTask id="Task_HODApproval" name="HOD Approval"/>
    <bpmn:intermediateCatchEvent id="Event_HODApproved" name="Approved">
      <bpmn:messageEventDefinition id="MessageDef_HODApproved"/>
    </bpmn:intermediateCatchEvent>
    <bpmn:intermediateThrowEvent id="Event_HODReworked" name="Reworked"/>
    <bpmn:intermediateThrowEvent id="Event_HODRejected" name="Rejected"/>

    <bpmn:userTask id="Task_LineDepartment" name="Line Department Review"/>
    <bpmn:intermediateCatchEvent id="Event_LineReviewed" name="Reviewed">
      <bpmn:messageEventDefinition id="MessageDef_LineReviewed"/>
    </bpmn:intermediateCatchEvent>
    <bpmn:intermediateThrowEvent id="Event_LineReworked" name="Reworked"/>
    <bpmn:intermediateThrowEvent id="Event_LineRejected" name="Rejected"/>

    <bpmn:userTask id="Task_DepartmentExecutive" name="Department Executive Review"/>
    <bpmn:intermediateCatchEvent id="Event_DeptExecReviewed" name="Reviewed">
      <bpmn:messageEventDefinition id="MessageDef_DeptExecReviewed"/>
    </bpmn:intermediateCatchEvent>
    <bpmn:intermediateThrowEvent id="Event_DeptExecReworked" name="Reworked"/>
    <bpmn:intermediateThrowEvent id="Event_DeptExecRejected" name="Rejected"/>

    <bpmn:exclusiveGateway id="Gateway_FinanceRoute" name="Finance Route"/>

    <bpmn:userTask id="Task_FinanceGaming" name="Finance - Gaming"/>
    <bpmn:userTask id="Task_FinanceHotel" name="Finance - Hotel"/>
    <bpmn:userTask id="Task_GroupFinance" name="Group Finance"/>
    <bpmn:userTask id="Task_CFO_DYCFO" name="CFO / DYCFO"/>
    <bpmn:userTask id="Task_CFO" name="CFO"/>

    <bpmn:intermediateCatchEvent id="Event_FinanceReviewed" name="Reviewed">
      <bpmn:messageEventDefinition id="MessageDef_FinanceReviewed"/>
    </bpmn:intermediateCatchEvent>
    <bpmn:intermediateThrowEvent id="Event_FinanceReworked" name="Reworked"/>
    <bpmn:intermediateThrowEvent id="Event_FinanceRejected" name="Rejected"/>

    <bpmn:exclusiveGateway id="Gateway_FinanceApprovedJoin" name="Finance Approved Join"/>

    <bpmn:sendTask id="Task_EmailNotification" name="Email Notification to Submitter"/>
    <bpmn:intermediateThrowEvent id="Event_EmailSent" name="Email Sent"/>

    <bpmn:userTask id="Task_Purchasing" name="Purchasing (PO Number/Date/Value)"/>
    <bpmn:intermediateCatchEvent id="Event_PurchaseDone" name="Done">
      <bpmn:messageEventDefinition id="MessageDef_PurchaseDone"/>
    </bpmn:intermediateCatchEvent>

    <bpmn:exclusiveGateway id="Gateway_ModificationWindow" name="Modification Window (1 Month)"/>
    <bpmn:userTask id="Task_Modification" name="Modification (Comments/Attachments/PO Fields)"/>
    <bpmn:intermediateCatchEvent id="Event_ModificationSaved" name="Saved">
      <bpmn:messageEventDefinition id="MessageDef_ModificationSaved"/>
    </bpmn:intermediateCatchEvent>

    <bpmn:endEvent id="EndEvent_Completed" name="Completed"/>
    <bpmn:endEvent id="EndEvent_Rejected" name="Rejected"/>

    <bpmn:sequenceFlow id="Flow_01" sourceRef="StartEvent_BCJ" targetRef="Task_Submitter"/>
    <bpmn:sequenceFlow id="Flow_02" sourceRef="Task_Submitter" targetRef="Event_Submit"/>
    <bpmn:sequenceFlow id="Flow_03" sourceRef="Event_Submit" targetRef="Task_HODApproval"/>

    <bpmn:sequenceFlow id="Flow_04" sourceRef="Task_HODApproval" targetRef="Event_HODApproved"/>
    <bpmn:sequenceFlow id="Flow_05" sourceRef="Event_HODApproved" targetRef="Task_LineDepartment"/>
    <bpmn:sequenceFlow id="Flow_06" sourceRef="Task_HODApproval" targetRef="Event_HODReworked"/>
    <bpmn:sequenceFlow id="Flow_07" sourceRef="Event_HODReworked" targetRef="Task_Submitter"/>
    <bpmn:sequenceFlow id="Flow_08" sourceRef="Task_HODApproval" targetRef="Event_HODRejected"/>
    <bpmn:sequenceFlow id="Flow_09" sourceRef="Event_HODRejected" targetRef="EndEvent_Rejected"/>

    <bpmn:sequenceFlow id="Flow_10" sourceRef="Task_LineDepartment" targetRef="Event_LineReviewed"/>
    <bpmn:sequenceFlow id="Flow_11" sourceRef="Event_LineReviewed" targetRef="Task_DepartmentExecutive"/>
    <bpmn:sequenceFlow id="Flow_12" sourceRef="Task_LineDepartment" targetRef="Event_LineReworked"/>
    <bpmn:sequenceFlow id="Flow_13" sourceRef="Event_LineReworked" targetRef="Task_HODApproval"/>
    <bpmn:sequenceFlow id="Flow_14" sourceRef="Task_LineDepartment" targetRef="Event_LineRejected"/>
    <bpmn:sequenceFlow id="Flow_15" sourceRef="Event_LineRejected" targetRef="EndEvent_Rejected"/>

    <bpmn:sequenceFlow id="Flow_16" sourceRef="Task_DepartmentExecutive" targetRef="Event_DeptExecReviewed"/>
    <bpmn:sequenceFlow id="Flow_17" sourceRef="Event_DeptExecReviewed" targetRef="Gateway_FinanceRoute"/>
    <bpmn:sequenceFlow id="Flow_18" sourceRef="Task_DepartmentExecutive" targetRef="Event_DeptExecReworked"/>
    <bpmn:sequenceFlow id="Flow_19" sourceRef="Event_DeptExecReworked" targetRef="Task_LineDepartment"/>
    <bpmn:sequenceFlow id="Flow_20" sourceRef="Task_DepartmentExecutive" targetRef="Event_DeptExecRejected"/>
    <bpmn:sequenceFlow id="Flow_21" sourceRef="Event_DeptExecRejected" targetRef="EndEvent_Rejected"/>

    <bpmn:sequenceFlow id="Flow_22" sourceRef="Gateway_FinanceRoute" targetRef="Task_FinanceGaming">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">[('total_amount', '&lt;=', 500), ('branch_company', '=', 'gaming')]</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_23" sourceRef="Gateway_FinanceRoute" targetRef="Task_FinanceHotel">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">[('total_amount', '&lt;=', 500), ('branch_company', '=', 'hotel')]</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_24" sourceRef="Gateway_FinanceRoute" targetRef="Task_GroupFinance">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">[('total_amount', '&lt;=', 500), ('branch_company', '=', 'others')]</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_25" sourceRef="Gateway_FinanceRoute" targetRef="Task_CFO_DYCFO">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">[('total_amount', '&gt;', 500), ('total_amount', '&lt;=', 100000)]</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_26" sourceRef="Gateway_FinanceRoute" targetRef="Task_CFO">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">[('total_amount', '&gt;', 100000)]</bpmn:conditionExpression>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="Flow_27" sourceRef="Task_FinanceGaming" targetRef="Event_FinanceReviewed"/>
    <bpmn:sequenceFlow id="Flow_28" sourceRef="Task_FinanceHotel" targetRef="Event_FinanceReviewed"/>
    <bpmn:sequenceFlow id="Flow_29" sourceRef="Task_GroupFinance" targetRef="Event_FinanceReviewed"/>
    <bpmn:sequenceFlow id="Flow_30" sourceRef="Task_CFO_DYCFO" targetRef="Event_FinanceReviewed"/>
    <bpmn:sequenceFlow id="Flow_31" sourceRef="Task_CFO" targetRef="Event_FinanceReviewed"/>

    <bpmn:sequenceFlow id="Flow_32" sourceRef="Event_FinanceReviewed" targetRef="Gateway_FinanceApprovedJoin"/>

    <bpmn:sequenceFlow id="Flow_33" sourceRef="Task_FinanceGaming" targetRef="Event_FinanceReworked"/>
    <bpmn:sequenceFlow id="Flow_34" sourceRef="Task_FinanceHotel" targetRef="Event_FinanceReworked"/>
    <bpmn:sequenceFlow id="Flow_35" sourceRef="Task_GroupFinance" targetRef="Event_FinanceReworked"/>
    <bpmn:sequenceFlow id="Flow_36" sourceRef="Task_CFO_DYCFO" targetRef="Event_FinanceReworked"/>
    <bpmn:sequenceFlow id="Flow_37" sourceRef="Task_CFO" targetRef="Event_FinanceReworked"/>
    <bpmn:sequenceFlow id="Flow_38" sourceRef="Event_FinanceReworked" targetRef="Task_DepartmentExecutive"/>

    <bpmn:sequenceFlow id="Flow_39" sourceRef="Task_FinanceGaming" targetRef="Event_FinanceRejected"/>
    <bpmn:sequenceFlow id="Flow_40" sourceRef="Task_FinanceHotel" targetRef="Event_FinanceRejected"/>
    <bpmn:sequenceFlow id="Flow_41" sourceRef="Task_GroupFinance" targetRef="Event_FinanceRejected"/>
    <bpmn:sequenceFlow id="Flow_42" sourceRef="Task_CFO_DYCFO" targetRef="Event_FinanceRejected"/>
    <bpmn:sequenceFlow id="Flow_43" sourceRef="Task_CFO" targetRef="Event_FinanceRejected"/>
    <bpmn:sequenceFlow id="Flow_44" sourceRef="Event_FinanceRejected" targetRef="EndEvent_Rejected"/>

    <bpmn:sequenceFlow id="Flow_45" sourceRef="Gateway_FinanceApprovedJoin" targetRef="Task_EmailNotification"/>
    <bpmn:sequenceFlow id="Flow_46" sourceRef="Task_EmailNotification" targetRef="Event_EmailSent"/>
    <bpmn:sequenceFlow id="Flow_47" sourceRef="Event_EmailSent" targetRef="Task_Purchasing"/>
    <bpmn:sequenceFlow id="Flow_48" sourceRef="Task_Purchasing" targetRef="Event_PurchaseDone"/>

    <bpmn:sequenceFlow id="Flow_49" sourceRef="Event_PurchaseDone" targetRef="Gateway_ModificationWindow"/>
    <bpmn:sequenceFlow id="Flow_50" sourceRef="Gateway_ModificationWindow" targetRef="EndEvent_Completed"/>
    <bpmn:sequenceFlow id="Flow_51" sourceRef="Gateway_ModificationWindow" targetRef="Task_Modification">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">[('allow_modification', '=', True)]</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_52" sourceRef="Task_Modification" targetRef="Event_ModificationSaved"/>
    <bpmn:sequenceFlow id="Flow_53" sourceRef="Event_ModificationSaved" targetRef="EndEvent_Completed"/>

  </bpmn:process>
</bpmn:definitions>
