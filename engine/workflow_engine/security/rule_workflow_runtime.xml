<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="rule_workflow_task_instance_user_scope" model="ir.rule">
            <field name="name">WF: Workflow Task Instance - User Scope</field>
            <field name="model_id" ref="workflow_engine.model_workflow_request_task_instance"/>
            <field name="groups" eval="[(6, 0, [ref('workflow_engine.group_workflow_approval_user')])]"/>
            <field name="domain_force">
                ['|','|','|','|','|',
                    ('request_id.request_owner_id', '=', user.id),
                    ('request_id.create_uid', '=', user.id),
                    ('request_id.approver_ids.user_id', '=', user.id),
                    ('assignee_ids.assignee_user_id', '=', user.id),
                    ('request_id.visibility_scope_user_ids', 'in', [user.id]),
                    ('request_id.visibility_scope_group_ids', 'in', user.all_group_ids.ids)
                ]
            </field>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>

