<odoo>
    <data noupdate="1">
        <!-- Normal users (internal) -->
        <record id="access_workflow_map_by_system_user" model="ir.model.access">
            <field name="name">WF: access workflow map by system user</field>
            <field name="model_id" ref="model_workflow_category_version_meta_task_workflow_map"/>
            <field name="group_id" ref="base.group_user"/>
            <field name="perm_read" eval="1"/>
            <field name="perm_write" eval="1"/>
            <field name="perm_create" eval="1"/>
            <field name="perm_unlink" eval="0"/>
        </record>

        <!-- Administrators (full rights) -->
        <record id="access_workflow_map_by_system_admin" model="ir.model.access">
            <field name="name">WF: access workflow map by system admin</field>
            <field name="model_id" ref="model_workflow_category_version_meta_task_workflow_map"/>
            <field name="group_id" ref="base.group_system"/>
            <field name="perm_read" eval="1"/>
            <field name="perm_write" eval="1"/>
            <field name="perm_create" eval="1"/>
            <field name="perm_unlink" eval="1"/>
        </record>

