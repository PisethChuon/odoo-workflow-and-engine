<odoo>
    <data>
        <function model="ir.model.data" name="write">
            <function model="ir.model.data" name="search">
                <value eval="[('module', '=', 'workflow_engine'), ('name', '=', 'access_workflow_approval_action_by_admin')]"/>
            </function>
            <value eval="{'noupdate': False}"/>
        </function>
        <record id="access_workflow_approval_action_by_admin" model="ir.model.access">
            <field name="name">WF: access workflow approval action by admin</field>
            <field name="model_id" ref="workflow_engine.model_workflow_approval_action"/>
            <field name="group_id" ref="workflow_engine.group_workflow_approval_admin"/>
            <field name="perm_read" eval="1"/>
            <field name="perm_write" eval="1"/>
            <field name="perm_create" eval="1"/>
            <field name="perm_unlink" eval="1"/>
        </record>
        <record id="access_workflow_requestor_import_wizard_user" model="ir.model.access">
