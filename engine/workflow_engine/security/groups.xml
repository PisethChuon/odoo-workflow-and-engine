<odoo>
    <data noupdate="1">
        <!--
        create workflow category
        -->
        <record id="module_category_workflow" model="ir.module.category">
            <field name="sequence">9</field>
            <field name="name">Workflow</field>
        </record>

        <!-- Privilege (Odoo 19: this is where category_id goes) -->
        <!-- <record id="res_groups_privilege_workflow_approval" model="res.groups.privilege">
            <field name="name">Workflow Approval</field>
            <field name="sequence">9</field>
            <field name="category_id" ref="workflow_engine.module_category_workflow"/>
        </record> -->

        <record id="group_workflow_request_reader" model="res.groups">
            <field name="name">WF: Request Reader</field>
            <field name="implied_ids" eval="[(6,0,[ref('base.group_user')])]"/>
            <field name="comment">Can open workflow requests when another read path grants visibility.</field>
        </record>

        <!--
        Everyone is a user of workflow module.
        -->
        <record id="group_workflow_approval_user" model="res.groups">
            <field name="name">WF: Approval User</field>
            <!-- <field name="privilege_id" ref="res_groups_privilege_workflow_approval"/> -->
            <field name="implied_ids" eval="[(6,0,[ref('group_workflow_request_reader')])]"/>
            <field name="comment">This is approval user</field>
        </record>

        <!--
        Admin can do anything as a user; and he/she can configure the workflow application.
        -->
        <record id="group_workflow_approval_admin" model="res.groups">
            <field name="name">WF: Approval Admin</field>
            <field name="comment">This is approval admin</field>
            <!-- <field name="privilege_id" ref="res_groups_privilege_workflow_approval"/> -->
            <field name="implied_ids" eval="[(6,0,[ref('group_workflow_approval_user'),ref('base.group_allow_export')])]"/>
            <field name="user_ids" eval="[(6,0,[ref('base.user_admin')])]"/>
        </record>

        <record id="group_workflow_technical_admin" model="res.groups">
            <field name="name">WF: Technical Admin</field>
            <field name="comment">Can access technical workflow fields and runtime diagnostics in request forms.</field>
            <!-- <field name="privilege_id" ref="res_groups_privilege_workflow_approval"/> -->
            <field name="implied_ids" eval="[(6,0,[ref('group_workflow_approval_admin')])]"/>
            <field name="user_ids" eval="[(6,0,[ref('base.user_admin')])]"/>
        </record>

        <record id="group_workflow_approval_user_matrix_report" model="res.groups">
            <field name="name">WF: Approval User Matrix Report</field>
            <field name="comment">Can open the workflow approval user matrix report for approval-group and notification audits.</field>
            <field name="implied_ids" eval="[(6,0,[ref('group_workflow_approval_user')])]"/>
            <field name="implied_by_ids" eval="[(4, ref('group_workflow_technical_admin'))]"/>
        </record>

        <record id="group_workflow_technical_support" model="res.groups">
            <field name="name">WF: Technical Support</field>
            <field name="comment">Can support workflow users by delegating active workflow activities.</field>
            <field name="implied_ids" eval="[(6,0,[ref('group_workflow_approval_user')])]"/>
        </record>

        <record id="group_workflow_view_history_user" model="res.groups">
            <field name="name">WF: View History User</field>
            <field name="comment">Can open workflow requester history popups when granted by child modules.</field>
        </record>

    </data>
</odoo>
