        <!-- Dry Run Wizard: accessible only to WF Technical Admin -->
        <record id="access_workflow_dryrun_wizard_technical_admin" model="ir.model.access">
            <field name="name">WF: access workflow dry run wizard by technical admin</field>
            <field name="model_id" ref="model_workflow_dryrun_wizard"/>
            <field name="group_id" ref="workflow_engine.group_workflow_technical_admin"/>
            <field name="perm_read" eval="1"/>
            <field name="perm_write" eval="1"/>
            <field name="perm_create" eval="1"/>
            <field name="perm_unlink" eval="1"/>
        </record>

