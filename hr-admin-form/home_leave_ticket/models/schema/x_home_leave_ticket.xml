<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <data noupdate="0">
        <!-- Home Leave Ticket Type Model -->
        <record id="model_x_home_leave_ticket_type" model="ir.model">
            <field name="name">Home Leave Ticket Type</field>
            <field name="model">x_home_leave_ticket_type</field>
            <field name="state">manual</field>
            <field name="info">Model to define types of home leave tickets (e.g., Economy, Business)</field>
        </record>

        <!-- Home Leave Ticket Type Fields -->
        <record id="field_x_home_leave_ticket_type__name" model="ir.model.fields">
            <field name="name">x_name</field>
            <field name="ttype">char</field>
            <field name="model">x_home_leave_ticket_type</field>
            <field name="model_id" ref="model_x_home_leave_ticket_type"/>
            <field name="field_description">Ticket Type Name</field>
            <field name="required" eval="True"/>
        </record>

        <record id="field_x_home_leave_ticket_type__active" model="ir.model.fields">
            <field name="name">x_active</field>
            <field name="ttype">boolean</field>
            <field name="model">x_home_leave_ticket_type</field>
            <field name="model_id" ref="model_x_home_leave_ticket_type"/>
            <field name="field_description">Active</field>
        </record>

        <record id="field_x_home_leave_ticket_type__sequence" model="ir.model.fields">
            <field name="name">x_sequence</field>
            <field name="ttype">integer</field>
            <field name="model">x_home_leave_ticket_type</field>
            <field name="model_id" ref="model_x_home_leave_ticket_type"/>
            <field name="field_description">Sequence</field>
        </record>

        <!-- Home Leave Ticket Model -->
        <record id="model_x_home_leave_ticket" model="ir.model">
            <field name="name">Home Leave Ticket</field>
            <field name="model">x_home_leave_ticket</field>
        </record>

        <!-- Home Leave Ticket Fields -->
        <record id="field_x_home_leave_ticket__ticket_type_id" model="ir.model.fields">
            <field name="name">x_ticket_type_id</field>
            <field name="ttype">many2one</field>
            <field name="model">x_home_leave_ticket</field>
            <field name="model_id" ref="model_x_home_leave_ticket"/>
            <field name="relation">x_home_leave_ticket_type</field>
            <field name="field_description">Home Leave Ticket Type</field>
            <field name="required" eval="True"/>
            <field name="on_delete">restrict</field>
        </record>

        <record id="field_x_home_leave_ticket__destination_requested" model="ir.model.fields">
            <field name="name">x_destination_requested</field>
            <field name="ttype">char</field>
            <field name="model">x_home_leave_ticket</field>
            <field name="model_id" ref="model_x_home_leave_ticket"/>
            <field name="field_description">Destination Requested</field>
            <field name="required" eval="True"/>
        </record>

        <!-- Deprecated field - kept for backwards compatibility -->
        <record id="field_x_home_leave_ticket_type" model="ir.model.fields">
            <field name="name">x_home_leave_ticket_type</field>
            <field name="ttype">many2one</field>
            <field name="model">x_home_leave_ticket</field>
            <field name="model_id" ref="model_x_home_leave_ticket"/>
            <field name="field_description">Class of Travel Request</field>
        </record>

        <!-- x_description -->
        <record id="field_x_home_leave_ticket__description" model="ir.model.fields">
            <field name="name">x_description</field>
            <field name="ttype">text</field>
            <field name="model">x_home_leave_ticket</field>
            <field name="model_id" ref="model_x_home_leave_ticket"/>
            <field name="field_description">Description</field>
        </record>

        <!-- HR Review Session Fields -->
        <!-- 1. Class of Travel as per Entitlement (Editable by HR) -->
        <record id="field_x_home_leave_ticket__class_of_travel_entitlement" model="ir.model.fields">
            <field name="name">x_class_of_travel_entitlement</field>
            <field name="ttype">many2one</field>
            <field name="model">x_home_leave_ticket</field>
            <field name="model_id" ref="model_x_home_leave_ticket"/>
            <field name="relation">x_home_leave_ticket_type</field>
            <field name="field_description">Class of Travel as per Entitlement</field>
            <field name="on_delete">restrict</field>
        </record>

        <!-- 2. Date Join (Auto-populated from employee) -->
        <record id="field_x_home_leave_ticket__date_join" model="ir.model.fields">
            <field name="name">x_date_join</field>
            <field name="ttype">date</field>
            <field name="model">x_home_leave_ticket</field>
            <field name="model_id" ref="model_x_home_leave_ticket"/>
            <field name="field_description">Date Join</field>
            <field name="related">request_owner_emp_id.date_start</field>
            <field name="readonly" eval="True"/>
            <field name="store" eval="True"/>
        </record>

        <!-- 3. Company Code & Line Code (Auto-populated from employee) -->
        <record id="field_x_home_leave_ticket__company_and_line_code" model="ir.model.fields">
            <field name="name">x_company_and_line_code</field>
            <field name="ttype">char</field>
            <field name="model">x_home_leave_ticket</field>
            <field name="model_id" ref="model_x_home_leave_ticket"/>
            <field name="field_description">Company Code &amp; Line Code</field>
            <field name="readonly" eval="True"/>
            <field name="store" eval="True"/>
            <field name="depends">request_owner_emp_id,request_owner_emp_id.company_id,request_owner_emp_id.company_id.company_registry,request_owner_emp_id.x_line_code</field>
            <field name="compute"><![CDATA[
for rec in self:
    employee = rec.request_owner_emp_id
    if employee:
        company_code = employee.company_id.company_registry if employee.company_id else False
        line_code = employee.x_line_code or False
        if company_code and line_code:
            rec['x_company_and_line_code'] = f"{company_code}-{line_code}"
        elif company_code:
            rec['x_company_and_line_code'] = company_code
        elif line_code:
            rec['x_company_and_line_code'] = line_code
        else:
            rec['x_company_and_line_code'] = False
    else:
        rec['x_company_and_line_code'] = False
]]>
            </field>
        </record>

        <!-- 4. Destination Entitlement (Editable by HR) -->
        <record id="field_x_home_leave_ticket__destination_entitlement" model="ir.model.fields">
            <field name="name">x_destination_entitlement</field>
            <field name="ttype">text</field>
            <field name="model">x_home_leave_ticket</field>
            <field name="model_id" ref="model_x_home_leave_ticket"/>
            <field name="field_description">Destination Entitlement</field>
        </record>

        <!-- 5. Destination Authorized (Editable by HR) -->
        <record id="field_x_home_leave_ticket__destination_authorized" model="ir.model.fields">
            <field name="name">x_destination_authorized</field>
            <field name="ttype">text</field>
            <field name="model">x_home_leave_ticket</field>
            <field name="model_id" ref="model_x_home_leave_ticket"/>
            <field name="field_description">Destination Authorized</field>
        </record>

        <!-- 6. Comment (Editable - for HR reviewer) -->
        <record id="field_x_home_leave_ticket__hr_review_comment" model="ir.model.fields">
            <field name="name">x_hr_review_comment</field>
            <field name="ttype">text</field>
            <field name="model">x_home_leave_ticket</field>
            <field name="model_id" ref="model_x_home_leave_ticket"/>
            <field name="field_description">Comment</field>
            <field name="help">Comments or notes regarding the home leave ticket request</field>
        </record>

    </data>
</odoo>