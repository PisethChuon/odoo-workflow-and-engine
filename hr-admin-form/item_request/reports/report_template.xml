<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="item_request_request_template">
        <t t-call="workflow_engine.report_base_layout">
            <t t-set="report_title">Item Request Form</t>

            <div class="page">
                <t t-foreach="docs" t-as="doc">
                    <strong>Requested Items</strong>
                    <table class="table table-bordered mt-2">
                        <thead>
                            <tr>
                                <th class="text-center" style="width: 30px;"><strong>Nº</strong></th>
                                <th><strong>Employee</strong></th>
                                <th><strong>Item</strong></th>
                                <th><strong>Type</strong></th>
                                <th><strong>Comment</strong></th>
                            </tr>
                        </thead>
                        <tbody>
                            <t t-foreach="doc.x_item_line_ids" t-as="line">
                                <tr>
                                    <td class="text-center">
                                        <span t-esc="line_index + 1"/>
                                    </td>
                                    <td>
                                        <span t-field="line.x_employee_id.name"/>
                                    </td>
                                    <td>
                                        <span t-field="line.x_item_line_id.display_name"/>
                                    </td>
                                    <td>
                                        <span t-field="line.x_sub_itemline_id.display_name"/>
                                    </td>
                                    <td>
                                        <span t-field="line.x_comment"/>
                                    </td>
                                </tr>
                            </t>
                        </tbody>
                    </table>
                    
                    <!-- <p style="page-break-after:always;"/> -->
                </t>
            </div>
        </t>
    </template>
</odoo>