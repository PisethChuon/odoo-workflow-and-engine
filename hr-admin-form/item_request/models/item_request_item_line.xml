<odoo>
    <data noupdate="0">

        <!-- ========================= -->
        <!-- Define model (Studio rule) -->
        <!-- ========================= -->
        <record id="model_x_item_request_item_line" model="ir.model">
            <field name="name">Item Request  form item Line</field>
            <field name="model">x_item_request_item_line</field>
            <field name="field_id" eval="[]"/>
        </record>

        <!-- ========================= -->
        <!-- Define fields -->
        <!-- ========================= -->
        
        <!-- name -->
        <record id="field_x_item_request_item_line_name" model="ir.model.fields">
            <field name="name">x_name</field>
            <field name="field_description">Name</field>
            <field name="model_id" ref="model_x_item_request_item_line"/>
            <field name="ttype">char</field>
            <field name="required" eval="False"/>
        </record>

        <record id="field_x_item_request_x_item_line_id" model="ir.model.fields">
            <field name="name">x_item_line_id</field>
            <field name="field_description">Items</field>
            <field name="model_id" ref="model_x_item_request_item_line"/>
            <field name="ttype">many2one</field>
            <field name="relation">x_item_request_config_item_line</field>
            <field name="required" eval="False"/>
            <field name="on_delete">set null</field>
        </record>

        <record id="field_x_item_request_x_sub_itemline_id" model="ir.model.fields">
            <field name="name">x_sub_itemline_id</field>
            <field name="field_description">Item Type</field>
            <field name="model_id" ref="model_x_item_request_item_line"/>
            <field name="ttype">many2one</field>
            <field name="relation">x_item_request_config_sub_item_line</field>
            <field name="required" eval="False"/>
            <field name="on_delete">set null</field>
        </record>

        <record id="field_x_item_request_item_line_employee_id" model="ir.model.fields">
            <field name="name">x_employee_id</field>
            <field name="field_description">Employee</field>
            <field name="model_id" ref="model_x_item_request_item_line"/>
            <field name="ttype">many2one</field>
            <!-- <field name="relation">hr.employee</field> -->
            <field name="relation">hr.employee.public</field>
            <field name="required" eval="False"/>
            <field name="on_delete">set null</field>
        </record>
        
        <record id="field_x_item_request_item_line_comment" model="ir.model.fields">
            <field name="name">x_comment</field>
            <field name="field_description">Comment</field>
            <field name="model_id" ref="model_x_item_request_item_line"/>
            <field name="ttype">char</field>
        </record>
      
    </data>
</odoo>
