<odoo>
    <data>

        <!-- ========================= -->
        <!-- List View (was tree) -->
        <!-- ========================= -->
        <record id="view_x_item_request_config_item_line_list" model="ir.ui.view">
            <field name="name">x.item.request.item.line.list</field>
            <field name="model">x_item_request_config_item_line</field>
            <field name="arch" type="xml">
                <list string="Item Request Item Lines">
                    <field name="x_name"/>
                </list>
            </field>
        </record>

        <!-- ========================= -->
        <!-- Form View -->
        <!-- ========================= -->
        <record id="view_x_item_request_config_item_line_form" model="ir.ui.view">
            <field name="name">x.item.request.item.line.form</field>
            <field name="model">x_item_request_config_item_line</field>
            <field name="arch" type="xml">
                <form string="Item Request Item Line">
                    <sheet>
                        <group>
                            <field name="x_name" required="1"/>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <!-- ========================= -->
        <!-- Action -->
        <!-- ========================= -->
        <record id="action_x_item_request_config_item_line" model="ir.actions.act_window">
            <field name="name">Config Item Lines</field>
            <field name="res_model">x_item_request_config_item_line</field>
            <field name="view_mode">list,form</field>
        </record>

    </data>
</odoo>
