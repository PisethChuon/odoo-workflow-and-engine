<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">
        <record id="model_x_item_request_type" model="ir.model">
            <field name="name">Item Request Type</field>
            <field name="model">x_item_request_type</field>
            <field name="order">id</field>
        </record>

        <record id="field_x_item_request_type_name" model="ir.model.fields">
            <field name="name">x_name</field>
            <field name="ttype">char</field>
            <field name="model">x_item_request_type</field>
            <field name="model_id" ref="model_x_item_request_type"/>
            <field name="field_description">Item Type</field>
            <field name="required" eval="True"/>
            <field name="tracking" eval="1"/>
        </record>

        <record id="field_x_item_request_type_description" model="ir.model.fields">
            <field name="name">x_description</field>
            <field name="ttype">text</field>
            <field name="model">x_item_request_type</field>
            <field name="model_id" ref="model_x_item_request_type"/>
