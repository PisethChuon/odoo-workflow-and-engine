        </record>

        <record id="field_x_item_request_type_active" model="ir.model.fields">
            <field name="name">x_active</field>
            <field name="ttype">boolean</field>
            <field name="model">x_item_request_type</field>
            <field name="model_id" ref="model_x_item_request_type"/>
