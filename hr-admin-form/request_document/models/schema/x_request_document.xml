<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <data noupdate="1">
        <!-- Request Document Information -->
        <record id="model_x_request_document" model="ir.model">
            <field name="name">Request Document</field>
            <field name="model">x_request_document</field>
            <field name="is_mail_thread" eval="True"/>
            <field name="is_mail_activity" eval="True"/>
            <field name="is_approval" eval="True"/>
        </record>

        <!-- Document Type -->
        <record id="field_x_request_document_type" model="ir.model.fields">
            <field name="name">x_request_document_type</field>
            <field name="model_id" ref="model_x_request_document"/>
            <field name="ttype">selection</field>
            <field name="selection">[('income_statement', 'Income Statement'), ('certificate_of_employment', 'Certificate of Employment')]</field>
            <field name="model">x_request_document</field>
            <field name="field_description">Document Type</field>
        </record>

        <!-- Personal Information -->
        <record id="field_x_request_document_personal_information" model="ir.model.fields">
            <field name="name">x_request_document_personal_information</field>
            <field name="model_id" ref="model_x_request_document"/>
            <field name="ttype">text</field>
            <field name="model">x_request_document</field>
            <field name="field_description">Personal Information</field>
        </record>

        <!-- Reason -->
        <record id="field_x_request_document_reason" model="ir.model.fields">
            <field name="name">x_request_document_reason</field>
            <field name="model_id" ref="model_x_request_document"/>
            <field name="ttype">text</field>
            <field name="model">x_request_document</field>
            <field name="field_description">Reason for Request</field>
        </record>

        <!-- Other Fields -->
        <record id="field_x_request_document_other_fields" model="ir.model.fields">
            <field name="name">x_request_document_other_fields</field>
            <field name="model_id" ref="model_x_request_document"/>
            <field name="ttype">char</field>
            <field name="model">x_request_document</field>
            <field name="field_description">Other</field>
        </record>

    </data>
</odoo>