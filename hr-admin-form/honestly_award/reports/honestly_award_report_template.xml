<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="x_honestly_award_report_template">
        <t t-call="workflow_engine.report_base_layout">
            <t t-set="report_title">Honestly Award Form</t>

            <div class="page">
                <t t-foreach="docs" t-as="doc">
                    <strong>Founder Information</strong>
                    <hr/>
                    <table class="table table-bordered mt-2">
                        <thead>
                            <tr>
                                <th class="text-center" style="width: 30px;">
                                    <strong>No.</strong>
                                </th>
                                <th>
                                    <strong>Founder</strong>
                                </th>
                                <th>
                                    <strong>Item</strong>
                                </th>
                                <th>
                                    <strong>Location</strong>
                                </th>
                                <th>
                                    <strong>Date</strong>
                                </th>
                                <th>
                                    <strong>Estimate Value</strong>
                                </th>
                                <th>
                                    <strong>Remark</strong>
                                </th>
                            </tr>
                        </thead>
                        <tbody>
                            <t t-foreach="doc.x_honestly_award_detail_ids" t-as="line">
                                <tr>
                                    <td class="text-center">
                                        <span t-esc="line_index + 1"/>
                                    </td>
                                    <td>
                                        <span t-field="line.x_employee_id"/>
                                    </td>
                                    <td>
                                        <span t-field="line.x_item_id"/>
                                    </td>
                                    <td>
                                        <span t-field="line.x_location_id"/>
                                    </td>
                                    <td>
                                        <span t-field="line.x_date"/>
                                    </td>
                                    <td class="text-right">
                                        <span t-esc="'{:,.2f}'.format(line.x_estimate_value)"/>
                                    </td>
                                    <td>
                                        <span t-field="line.x_remark"/>
                                    </td>
                                </tr>
                            </t>
                        </tbody>
                    </table>
                </t>
            </div>
        </t>
    </template>
</odoo>
