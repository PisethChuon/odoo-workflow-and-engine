<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data noupdate="0">
        <!-- Honestly Award Model -->
        <record id="model_x_honestly_award" model="ir.model">
            <field name="name">Honestly Award</field>
            <field name="model">x_honestly_award</field>
            <field name="is_mail_thread" eval="True"/>
