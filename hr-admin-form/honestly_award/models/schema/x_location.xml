<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <data noupdate="0">
        <!-- Location Model -->
        <record id="model_x_location" model="ir.model">
            <field name="name">Location</field>
            <field name="model">x_location</field>
        </record>

        <!-- Location Name Field -->
        <record id="field_x_location__x_name" model="ir.model.fields">
            <field name="name">x_name</field>
            <field name="ttype">char</field>
            <field name="model">x_location</field>
            <field name="model_id" ref="model_x_location"/>
            <field name="field_description">Location Name</field>
            <field name="required" eval="True"/>
        </record>

        <!-- Location Description Field -->
        <record id="field_x_location__description" model="ir.model.fields">
            <field name="name">x_description</field>
            <field name="ttype">text</field>
            <field name="model">x_location</field>
            <field name="model_id" ref="model_x_location"/>
            <field name="field_description">Description</field>
        </record>
    </data>
</odoo>
