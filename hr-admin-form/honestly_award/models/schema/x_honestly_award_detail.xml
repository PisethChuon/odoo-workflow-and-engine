<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <data noupdate="0">
        <record id="model_x_honestly_award_detail" model="ir.model">
            <field name="name">Honestly Award Detail</field>
            <field name="model">x_honestly_award_detail</field>
        </record>

        <record id="field_x_honestly_award_detail__honestly_award_id" model="ir.model.fields">
            <field name="name">x_honestly_award_id</field>
            <field name="ttype">many2one</field>
            <field name="relation">x_honestly_award</field>
            <field name="model">x_honestly_award_detail</field>
            <field name="model_id" ref="model_x_honestly_award_detail"/>
            <field name="field_description">Honestly Award</field>
            <field name="on_delete">cascade</field>
        </record>

        <!-- Founder Name -->
        <record id="field_x_honestly_award_detail__employee_id" model="ir.model.fields">
            <field name="name">x_employee_id</field>
            <field name="ttype">many2one</field>
            <field name="relation">hr.employee.public</field>
            <field name="model">x_honestly_award_detail</field>
            <field name="model_id" ref="model_x_honestly_award_detail"/>
            <field name="field_description">Founder Name</field>
            <field name="on_delete">restrict</field>
            <field name="required" eval="True"/>
        </record>

        <!-- Item -->
        <record id="field_x_honestly_award_detail__item" model="ir.model.fields">
            <field name="name">x_item_id</field>
            <field name="ttype">many2one</field>
            <field name="relation">x_item</field>
            <field name="model">x_honestly_award_detail</field>
            <field name="model_id" ref="model_x_honestly_award_detail"/>
            <field name="field_description">Item</field>
            <field name="required" eval="True"/>
            <field name="on_delete">restrict</field>
        </record>

        <!-- Location -->
        <record id="field_x_honestly_award_detail__location" model="ir.model.fields">
            <field name="name">x_location_id</field>
            <field name="ttype">many2one</field>
            <field name="relation">x_location</field>
            <field name="model">x_honestly_award_detail</field>
            <field name="model_id" ref="model_x_honestly_award_detail"/>
            <field name="field_description">Location</field>
            <field name="on_delete">restrict</field>
        </record>

        <!-- Date -->
        <record id="field_x_honestly_award_detail__date" model="ir.model.fields">
            <field name="name">x_date</field>
            <field name="ttype">date</field>
            <field name="model">x_honestly_award_detail</field>
            <field name="model_id" ref="model_x_honestly_award_detail"/>
            <field name="field_description">Date</field>
        </record>

        <!-- Estimate Value -->
        <record id="field_x_honestly_award_detail__estimate_value" model="ir.model.fields">
            <field name="name">x_estimate_value</field>
            <field name="ttype">float</field>
            <field name="model">x_honestly_award_detail</field>
            <field name="model_id" ref="model_x_honestly_award_detail"/>
            <field name="field_description">Estimate Value</field>
        </record>
        
        <!-- Remark -->
        <record id="field_x_honestly_award_detail__remark" model="ir.model.fields">
            <field name="name">x_remark</field>
            <field name="ttype">text</field>
            <field name="model">x_honestly_award_detail</field>
            <field name="model_id" ref="model_x_honestly_award_detail"/>
            <field name="field_description">Remark</field>
        </record>

    </data>
</odoo>