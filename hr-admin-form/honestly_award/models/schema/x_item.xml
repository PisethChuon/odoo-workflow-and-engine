<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <data noupdate="0">
        <!-- Item Model -->
        <record id="model_x_item" model="ir.model">
            <field name="name">Item</field>
            <field name="model">x_item</field>
        </record>

        <!-- Item Name Field -->
        <record id="field_x_item__x_name" model="ir.model.fields">
            <field name="name">x_name</field>
            <field name="ttype">char</field>
            <field name="model">x_item</field>
            <field name="model_id" ref="model_x_item"/>
            <field name="field_description">Item Name</field>
            <field name="required" eval="True"/>
        </record>

        <!-- Item Description Field -->
        <record id="field_x_item__description" model="ir.model.fields">
            <field name="name">x_description</field>
            <field name="ttype">text</field>
            <field name="model">x_item</field>
            <field name="model_id" ref="model_x_item"/>
            <field name="field_description">Description</field>
        </record>
    </data>
</odoo>
