<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">
        <record id="model_x_car_model" model="ir.model">
            <field name="name">Car Model</field>
            <field name="model">x_car_model</field>
            <field name="order">id</field>
        </record>

        <record id="field_x_car_model_name" model="ir.model.fields">
            <field name="name">x_name</field>
            <field name="ttype">char</field>
            <field name="model">x_car_model</field>
            <field name="model_id" ref="model_x_car_model"/>
            <field name="field_description">Car Model</field>
            <field name="required" eval="True"/>
            <field name="tracking" eval="1"/>
        </record>

        <record id="field_x_car_model_active" model="ir.model.fields">
            <field name="name">x_active</field>
            <field name="ttype">boolean</field>
            <field name="model">x_car_model</field>
            <field name="model_id" ref="model_x_car_model"/>
            <field name="field_description">Active</field>
        </record>

        <record id="default_x_car_model_active" model="ir.default">
            <field name="field_id" ref="field_x_car_model_active"/>
            <field name="json_value">1</field>
        </record>
    </data>
</odoo>
