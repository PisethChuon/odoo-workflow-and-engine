<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">
        <!-- Run normalization + validation after create and on write -->
        <record id="automation_cpp_normalize_plate" model="base.automation">
            <field name="name">CPP: Normalize Plate</field>
            <field name="model_id" ref="model_x_car_park_request"/>
            <field name="trigger">on_create_or_write</field>
            <field name="active" eval="True"/>
        </record>

        <record id="automation_cpp_validate_year" model="base.automation">
            <field name="name">CPP: Validate Year of Production</field>
            <field name="model_id" ref="model_x_car_park_request"/>
            <field name="trigger">on_create_or_write</field>
            <field name="active" eval="True"/>
        </record>
    </data>
</odoo>