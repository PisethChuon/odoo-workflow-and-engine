<odoo>
    <data noupdate="0">

        <!-- ========================= -->
        <!-- Define model (Studio rule) -->
        <!-- ========================= -->
        <record id="model_x_phone_allowance_item_line" model="ir.model">
            <field name="name">Phone Allowance item Line</field>
            <field name="model">x_phone_allowance_item_line</field>
            <field name="field_id" eval="[]"/>
        </record>

        <!-- ========================= -->
        <!-- Define fields -->
        <!-- ========================= -->
        
        <!-- name -->
        <record id="field_x_phone_allowance_item_line_name" model="ir.model.fields">
            <field name="name">x_name</field>
            <field name="field_description">Name</field>
            <field name="model_id" ref="model_x_phone_allowance_item_line"/>
            <field name="ttype">char</field>
            <field name="required" eval="False"/>
        </record>

        <record id="field_x_phone_allowance_request_item" model="ir.model.fields">
            <field name="name">x_request_item</field>
            <field name="field_description">Request Item</field>
            <field name="model_id" ref="model_x_phone_allowance_item_line"/>
            <field name="ttype">selection</field>
            <field name="selection">[('phone', 'Phone'), ('allowance', 'Allowance')]</field>
            <field name="required" eval="True"/>
        </record>

        <record id="field_x_phone_allowance_item_line_justification" model="ir.model.fields">
            <field name="name">x_justification</field>
            <field name="field_description">justification</field>
            <field name="model_id" ref="model_x_phone_allowance_item_line"/>
            <field name="ttype">char</field>
        </record>

        <record id="field_x_phone_allowance_item_line_employee_id" model="ir.model.fields">
            <field name="name">x_employee_id</field>
            <field name="field_description">Employee</field>
            <field name="model_id" ref="model_x_phone_allowance_item_line"/>
            <field name="ttype">many2one</field>
            <!-- <field name="relation">hr.employee</field> -->
            <field name="relation">hr.employee.public</field>
            <field name="required" eval="False"/>
            <field name="on_delete">set null</field>
        </record>
      
    </data>
</odoo>
