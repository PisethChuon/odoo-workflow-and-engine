<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data noupdate="1">

        <!-- Server Action -->
        <record id="action_clear_color_code_on_ui_change" model="ir.actions.server">
            <field name="name">EI: Reset Color Code Action Executer</field>
            <field name="model_id" ref="model_x_emergency_incident_information"/>
            <field name="state">code</field>
            <field name="code">
# When the type changes, reset the color code selection
record['x_color_code_id'] = False
            </field>
        </record>

        <!-- Base Automation Rule -->
        <record id="rule_clear_color_code_on_type_change" model="base.automation">
            <field name="name">EI: Reset Color Code on Type Change</field>
            <field name="model_id" ref="model_x_emergency_incident_information"/>
            <field name="trigger">on_change</field>
            <field name="on_change_field_ids" eval="[(4, ref('field_x_emergency_incident_information_x_type_of_incidents_id'))]"/>
            <field name="action_server_ids" eval="[(4, ref('action_clear_color_code_on_ui_change'))]"/>
        </record>

    </data>
</odoo>