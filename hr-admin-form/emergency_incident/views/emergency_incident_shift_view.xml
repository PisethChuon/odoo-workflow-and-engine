<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data noupdate="0">

        <record id="view_list_x_emergency_incident_shift" model="ir.ui.view">
            <field name="name">EI: Shift List Configuration</field>
            <field name="model">x_emergency_incident_shift</field>
            <field name="arch" type="xml">
                <list editable="bottom">
                    <field name="x_name"/>
                </list>
            </field>
        </record>

        <!-- Shift Search View (With Archived Filter) -->
        <record id="view_search_x_emergency_incident_shift" model="ir.ui.view">
            <field name="name">EI: Shift Search</field>
            <field name="model">x_emergency_incident_shift</field>
            <field name="arch" type="xml">
                <search>
                    <field name="x_name"/>
                    <filter string="Archived" name="inactive" domain="[('x_active', '=', False)]"/>
                </search>
            </field>
        </record>

        <!-- Window Action -->
        <record id="action_x_emergency_incident_shift" model="ir.actions.act_window">
            <field name="name">Incident Shifts</field>
            <field name="res_model">x_emergency_incident_shift</field>
            <field name="view_mode">list</field>
            <field name="search_view_id" ref="view_search_x_emergency_incident_shift"/>
        </record>

    </data>
</odoo>