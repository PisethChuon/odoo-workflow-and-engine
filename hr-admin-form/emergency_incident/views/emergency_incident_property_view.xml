<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data noupdate="0">

        <!-- List View -->
        <record id="view_list_x_emergency_incident_property" model="ir.ui.view">
            <field name="name">EI: Property List Configuration</field>
            <field name="model">x_emergency_incident_property</field>
            <field name="arch" type="xml">
                <list editable="bottom">
                    <field name="x_name"/>
                </list>
            </field>
        </record>

        <!-- Search View with Archived Filter -->
        <record id="view_search_x_emergency_incident_property" model="ir.ui.view">
            <field name="name">EI: Property Search View</field>
            <field name="model">x_emergency_incident_property</field>
            <field name="arch" type="xml">
                <search>
                    <field name="x_name"/>
                    <filter string="Archived" name="inactive" domain="[('x_active', '=', False)]"/>
                </search>
            </field>
        </record>

        <!-- Window Action (Linked to Search View) -->
        <record id="action_x_emergency_incident_property" model="ir.actions.act_window">
            <field name="name">Properties</field>
            <field name="res_model">x_emergency_incident_property</field>
            <field name="view_mode">list</field>
            <field name="search_view_id" ref="view_search_x_emergency_incident_property"/>
        </record>

    </data>
</odoo>