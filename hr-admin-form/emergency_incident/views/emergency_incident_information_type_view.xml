<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data noupdate="0">
        <record id="view_list_x_emergency_incident_information_type" model="ir.ui.view">
            <field name="name">EI: Emergency Incident Type List</field>
            <field name="model">x_emergency_incident_information_type</field>
            <field name="arch" type="xml">
                <list editable="bottom">
                    <field name="x_name"/>
                </list>
            </field>
        </record>

        <!-- Incident Type Search View -->
        <record id="view_search_x_emergency_incident_information_type" model="ir.ui.view">
            <field name="name">EI: Emergency Incident Type Search</field>
            <field name="model">x_emergency_incident_information_type</field>
            <field name="arch" type="xml">
                <search>
                    <field name="x_name"/>
                    <filter string="Archived" name="inactive" domain="[('x_active', '=', False)]"/>
                </search>
            </field>
        </record>
    </data>
</odoo>

