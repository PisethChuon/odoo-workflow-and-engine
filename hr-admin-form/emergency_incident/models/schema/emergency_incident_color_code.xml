<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data noupdate="0">
        <!-- The Color Code Model -->
        <record id="model_x_emergency_incident_color_code" model="ir.model">
            <field name="name">Incident Color Code</field>
            <field name="model">x_emergency_incident_color_code</field>
            <field name="order">id</field>
        </record>

        <!-- Field: Color Name (Blue, Assist, White, etc.) -->
        <record id="field_x_color_code_name" model="ir.model.fields">
            <field name="name">x_name</field>
            <field name="ttype">char</field>
            <field name="model">x_emergency_incident_color_code</field>
            <field name="model_id" ref="model_x_emergency_incident_color_code"/>
            <field name="field_description">Color Code</field>
            <field name="state">manual</field>
            <field name="required" eval="True"/>
        </record>

        <!-- Field: Link to Parent Incident Type -->
        <record id="field_x_color_incident_type_id" model="ir.model.fields">
            <field name="name">x_incident_type_id</field>
            <field name="ttype">many2one</field>
            <field name="relation">x_emergency_incident_information_type</field>
            <field name="model">x_emergency_incident_color_code</field>
            <field name="model_id" ref="model_x_emergency_incident_color_code"/>
            <field name="field_description">Incident Type</field>
            <field name="state">manual</field>
        </record>

        <!-- Field: Active -->
        <record id="field_x_color_code_active" model="ir.model.fields">
            <field name="name">x_active</field>
            <field name="ttype">boolean</field>
            <field name="model">x_emergency_incident_color_code</field>
            <field name="model_id" ref="model_x_emergency_incident_color_code"/>
            <field name="field_description">Active</field>
            <field name="state">manual</field>
        </record>

        <!-- Force x_active to be True by default -->
        <record id="default_x_color_code_active" model="ir.default">
            <field name="field_id" ref="field_x_color_code_active"/>
            <field name="json_value">true</field>
        </record>
    </data>
</odoo>